              "occurrenceSource": "duty_usher_dates",
              "occurrenceSort": "date",
              "rotationTable": "duty_ushers",
              "advanceBy": "occurrence"
            }
          },
          "interpreter",
          "accompanist",
          "chorister",
          {
            "view": "doc_welcome"
          },
          "presiding",
          "responsible",
          {
            "computed": {
              "matchList": "visitors",
              "fromColumns": [
                "testimony1",
                "testimony2",
                "talk1",
                "talk2",
                "talk3"
              ]
            },
            "name": "visitors"
          },
          "opening_hymn",
          {
            "name": "opening_prayer",
            "hideEmpty": false
          },
          {
            "sources": [
              "admin_callings"
            ],
            "columns": [],
            "bare": true,
            "mode": "union",
            "markdown": "{{t:text.ward_business}}",
            "hideEmpty": true,
            "filter": {
              "$or": [
                {
                  "status": "accepted"
                },
                {
                  "status": "released"
                }
              ]
            }
          },
          {
            "filter": {
              "status": "accepted"
            },
            "hideEmpty": true,
            "markdown": "{{t:text.sustaining_header}}\n\n{{self}}\n\n{{t:text.sustaining_footer}}",
            "readonly": true,
            "mode": "union",
            "bare": true,
            "columns": [
              "person",
              "organization",
              "calling"
            ],
            "sources": [
              "admin_callings"
            ]
          },
          {
            "mode": "union",
            "bare": true,
            "columns": [
              "person",
              "organization",
              "calling"
            ],
            "sources": [
              "admin_callings"
            ],
            "filter": {
              "status": "released"
            },
            "markdown": "{{t:text.releases_header}}\n\n{{self}}\n\n{{t:text.releases_footer}}",
            "hideEmpty": true,
            "readonly": true
          },
          {
            "view": "doc_sacrament_intro"
          },
          "sacrament_hymn",
          {
            "view": "doc_sacrament"
          },
          "testimony1",
          "testimony2",
          "talk1",
          "talk2",
          "musical_number",
          "intermediate_hymn",
          "talk3",
          {
            "view": "doc_thanks"
          },
          "closing_hymn",
          {
            "hideEmpty": false,
            "name": "closing_prayer"
          }
        ],
        "sources": [
          "meeting_agenda",
          "meeting_music",
          "duty_interpreters"
        ]
      },
      {
        "defaultSort": "date",
