        "markdown": "# Welcome\n\nThis site carries the sacrament meeting program and the ward duty rosters.\n\n{{view:doc_internal}}",
        "name": "doc_about"
      },
      {
        "access": [
          "all"
        ],
        "name": "doc_internal",
        "bare": true,
        "markdown": "# Bishopric tool"
      },
      {
        "markdown": "{{t:text.welcome}}",
        "bare": true,
        "name": "doc_welcome"
      },
      {
        "bare": true,
        "markdown": "{{t:text.sacrament_intro}}",
