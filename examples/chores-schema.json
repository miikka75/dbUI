{
  "$schema": "../schema.schema.json",
  "icons": {
    "favicon": "./examples/chores-favicon.svg",
    "appleTouch": "./examples/chores-icon-512.png",
    "png512": "./examples/chores-icon-512.png"
  },
  "theme": {
    "light": {
      "primary": "#00695c",
      "secondary": "#26a69a",
      "success": "#43a047"
    },
    "dark": {
      "primary": "#4db6ac",
      "secondary": "#26a69a",
      "success": "#66bb6a"
    }
  },
  "defaultLanguage": "English",
  "translatableLists": [
    "chore_status",
    "claim_status",
    "shop_status"
  ],
  "userWritableLists": [
    "shop_items"
  ],
  "listSources": {
    "members": "userlink"
  },
  "tables": {
    "ref_chores": {
      "isLookup": true,
      "columns": [
        {
          "name": "chore",
          "type": "text"
        },
        {
          "name": "points",
          "type": "number"
        }
      ]
    },
    "ref_rewards": {
      "isLookup": true,
      "columns": [
        {
          "name": "reward",
          "type": "text"
        },
        {
          "name": "cost",
          "type": "number"
        }
      ]
    },
    "chore_log": {
      "archivable": true,
      "defaultSort": "done_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "person",
          "type": "select",
          "list": "members",
          "sorted": true,
          "defaultFrom": "@me"
        },
        {
          "name": "chore",
          "type": "ref",
          "table": "ref_chores",
          "valueCol": "chore"
        },
        {
          "name": "done_on",
          "type": "date"
        },
        {
          "name": "status",
          "type": "select",
          "list": "chore_status",
          "picker": "toggle",
          "default": "logged"
        },
        {
          "name": "note",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archiveAfter": {
        "column": "status",
        "values": [
          "approved",
          "rejected"
        ],
        "days": 7
      },
      "ownerWritable": [
        "person",
        "chore",
        "done_on",
        "note"
      ],
      "ownerWritableWhile": {
        "status": "logged"
      }
    },
    "reward_claim": {
      "archivable": true,
      "defaultSort": "claimed_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "person",
          "type": "select",
          "list": "members",
          "sorted": true,
          "defaultFrom": "@me"
        },
        {
          "name": "reward",
          "type": "ref",
          "table": "ref_rewards",
          "valueCol": "reward"
        },
        {
          "name": "claimed_on",
          "type": "date"
        },
        {
          "name": "claim_status",
          "type": "select",
          "list": "claim_status",
          "picker": "toggle",
          "default": "requested"
        }
      ],
      "ownerWritable": [
        "person",
        "reward",
        "claimed_on"
      ],
      "ownerWritableWhile": {
        "claim_status": "requested"
      }
    },
    "tasks_ann": {
      "reorderable": true,
      "defaultSort": "position",
      "columns": [
        {
          "name": "position",
          "type": "number",
          "hidden": true
        },
        {
          "name": "tasks",
          "type": "select",
          "list": "ref_chores",
          "sorted": true,
          "multiple": true
        }
      ]
    },
    "tasks_bob": {
      "reorderable": true,
      "defaultSort": "position",
      "columns": [
        {
          "name": "position",
          "type": "number",
          "hidden": true
        },
        {
          "name": "tasks",
          "type": "select",
          "list": "ref_chores",
          "sorted": true,
          "multiple": true
        }
      ]
    },
    "tasks_cara": {
      "reorderable": true,
      "defaultSort": "position",
      "columns": [
        {
          "name": "position",
          "type": "number",
          "hidden": true
        },
        {
          "name": "tasks",
          "type": "select",
          "list": "ref_chores",
          "sorted": true,
          "multiple": true
        }
      ]
    },
    "tasks_dan": {
      "reorderable": true,
      "defaultSort": "position",
      "columns": [
        {
          "name": "position",
          "type": "number",
          "hidden": true
        },
        {
          "name": "tasks",
          "type": "select",
          "list": "ref_chores",
          "sorted": true,
          "multiple": true
        }
      ]
    },
    "home_shopping": {
      "archivable": true,
      "columns": [
        {
          "name": "item",
          "type": "select",
          "list": "shop_items",
          "allowNew": true,
          "sorted": true
        },
        {
          "name": "qty",
          "type": "text"
        },
        {
          "name": "shop_status",
          "type": "select",
          "list": "shop_status",
          "picker": "chips",
          "default": "needed"
        },
        {
          "name": "added_by",
          "type": "select",
          "list": "members",
          "sorted": true,
          "defaultFrom": "@me",
          "stamped": true
        },
        {
          "name": "needed_by",
          "type": "date"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archiveAfter": {
        "column": "shop_status",
        "values": [
          "bought"
        ],
        "days": 3
      }
    }
  },
  "views": [
    {
      "name": "doc_home",
      "markdown": "# {{t:text.home_heading}}\n\n{{t:text.home_intro}}\n\n{{t:text.rules_body}}\n\n## {{t:text.rules_points}}\n\n{{view:reward_shop}}\n",
      "icon": "mdi-home",
      "kind": "page"
    },
    {
      "name": "doc_mine",
      "icon": "mdi-account-check",
      "markdown": "## {{t:text.mine_tasks}}\n\n{{view:duty_matrix}}\n\n## {{t:text.mine_log}}\n\n{{view:chore_mine@both}}\n",
      "kind": "page"
    },
    {
      "name": "chore_mine",
      "search": true,
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "defaultSort": "done_on",
      "columns": [
        "done_on",
        "chore",
        "note",
        "status"
      ],
      "filter": {
        "person": "@me"
      },
      "icon": "mdi-clipboard-text-clock",
      "kind": "data"
    },
    {
      "name": "chore_board",
      "search": true,
      "sources": [
        "chore_log"
      ],
      "mode": "join",
      "defaultSort": "done_on",
      "columns": [
        "person",
        "done_on",
        "note"
      ],
      "hideEmpty": true,
      "board": {
        "lane": "status",
        "lanes": [
          "logged",
          "approved",
          "rejected"
        ],
        "title": "chore",
        "color": "person",
        "addInLane": true
      },
      "icon": "mdi-check-decagram",
      "kind": "board"
    },
    {
      "name": "chore_points_month",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "person"
        ]
      },
      "compute": [
        {
          "name": "points",
          "computed": {
            "lookup": {
              "table": "ref_chores",
              "match": "chore",
              "on": "chore",
              "field": "points",
              "default": 0
            }
          }
        }
      ],
      "aggregate": {
        "sum": "points",
        "into": "total"
      },
      "columns": [
        "person",
        "total"
      ],
      "period": "month",
      "filter": {
        "status": "approved",
        "done_on": {
          "within": "@month"
        }
      },
      "readonly": true,
      "icon": "mdi-medal",
      "includeArchive": true,
      "kind": "stats",
      "stats": {
        "perRow": {
          "label": "person",
          "value": "total"
        },
        "goal": [
          {
            "at": 10,
            "label": "text.tier_bronze"
          },
          {
            "at": 20,
            "label": "text.tier_silver"
          },
          {
            "at": 30,
            "label": "text.tier_gold"
          }
        ]
      }
    },
    {
      "name": "doc_scoreboard",
      "icon": "mdi-trophy",
      "markdown": "## {{t:text.score_pulse}}\n\n{{view:chore_pulse}}\n\n## {{t:text.score_week}}\n\n{{view:chore_points_week}}\n\n## {{t:text.score_month}}\n\n{{view:chore_points_month}}\n\n## {{t:text.score_balance}}\n\n{{view:chore_balance}}\n\n## {{t:text.score_who}}\n\n{{view:chore_heatmap}}\n",
      "kind": "page"
    },
    {
      "name": "chore_points_week",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "person"
        ]
      },
      "compute": [
        {
          "name": "points",
          "computed": {
            "lookup": {
              "table": "ref_chores",
              "match": "chore",
              "on": "chore",
              "field": "points",
              "default": 0
            }
          }
        }
      ],
      "aggregate": {
        "sum": "points",
        "into": "total"
      },
      "columns": [
        "person",
        "total"
      ],
      "period": "week",
      "filter": {
        "status": "approved",
        "done_on": {
          "within": "@week"
        }
      },
      "readonly": true,
      "icon": "mdi-chart-bar",
      "includeArchive": true,
      "kind": "stats",
      "stats": {
        "perRow": {
          "label": "person",
          "value": "total"
        },
        "goal": "max"
      }
    },
    {
      "name": "chore_pulse",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "readonly": true,
      "includeArchive": true,
      "icon": "mdi-gauge",
      "kind": "stats",
      "stats": {
        "display": "number",
        "tiles": [
          {
            "label": "text.pulse_awaiting",
            "agg": "count",
            "when": {
              "status": "logged"
            }
          },
          {
            "label": "text.pulse_approved_week",
            "agg": "count",
            "when": {
              "status": "approved",
              "done_on": {
                "within": "@week"
              }
            }
          },
          {
            "label": "text.pulse_today",
            "agg": "count",
            "when": {
              "done_on": {
                "within": "@today"
              }
            }
          }
        ]
      }
    },
    {
      "name": "chore_balance",
      "sources": [
        "chore_log",
        "reward_claim"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "person"
        ]
      },
      "compute": [
        {
          "name": "delta",
          "source": "chore_log",
          "computed": {
            "lookup": {
              "table": "ref_chores",
              "match": "chore",
              "on": "chore",
              "field": "points",
              "default": 0
            }
          }
        },
        {
          "name": "delta",
          "source": "reward_claim",
          "scale": -1,
          "computed": {
            "lookup": {
              "table": "ref_rewards",
              "match": "reward",
              "on": "reward",
              "field": "cost",
              "default": 0
            }
          }
        }
      ],
      "aggregate": {
        "sum": "delta",
        "into": "balance"
      },
      "columns": [
        "person",
        "balance"
      ],
      "filter": {
        "$or": [
          {
            "status": "approved"
          },
          {
            "claim_status": "granted"
          }
        ]
      },
      "readonly": true,
      "icon": "mdi-scale-balance",
      "includeArchive": true,
      "kind": "data"
    },
    {
      "name": "chore_heatmap",
      "pivot": {
        "source": "chore_log",
        "row": "person",
        "column": "chore",
        "aggregate": "count",
        "totals": "count"
      },
      "icon": "mdi-grid",
      "includeArchive": true,
      "kind": "pivot"
    },
    {
      "name": "home_calendar",
      "calendar": {
        "sources": [
          {
            "table": "chore_log",
            "dateColumn": "done_on",
            "titleColumns": [
              "chore",
              "person"
            ],
            "label": "Chore"
          },
          {
            "table": "home_shopping",
            "dateColumn": "needed_by",
            "titleColumns": [
              "item"
            ],
            "label": "Shopping"
          }
        ],
        "rotationSources": [
          {
            "view": "duty_matrix",
            "label": "Tasks"
          }
        ],
        "defaultView": "month",
        "weekStart": 1,
        "addTo": "chore_log"
      },
      "icon": "mdi-calendar-check",
      "kind": "calendar"
    },
    {
      "name": "duty_matrix",
      "layout": "table",
      "mineOnly": {
        "list": "members"
      },
      "rotation": {
        "slots": [
          "ann",
          "bob",
          "cara",
          "dan"
        ],
        "rosters": [
          "tasks_ann",
          "tasks_bob",
          "tasks_cara",
          "tasks_dan"
        ],
        "valueCol": "tasks",
        "interval": "weekly",
        "range": {
          "from": "today",
          "periods": 8
        }
      },
      "icon": "mdi-table-account",
      "kind": "rotation"
    },
    {
      "name": "shop_open",
      "sources": [
        "home_shopping"
      ],
      "mode": "join",
      "columns": [
        "item",
        "qty",
        "shop_status",
        "added_by",
        "needed_by",
        {
          "name": "days_late",
          "computed": {
            "daysSince": "needed_by"
          },
          "when": {
            "$and": [
              {
                "days_late": {
                  "gt": 0
                }
              },
              {
                "shop_status": {
                  "ne": "bought"
                }
              }
            ]
          }
        }
      ],
      "hideEmpty": true,
      "icon": "mdi-cart",
      "board": {
        "lane": "shop_status",
        "lanes": [
          "needed",
          "bought"
        ],
        "title": "item",
        "color": "added_by",
        "addInLane": true
      },
      "kind": "board"
    },
    {
      "name": "shop_todo",
      "search": [
        "item"
      ],
      "sources": [
        "home_shopping"
      ],
      "mode": "join",
      "layout": "table",
      "readonly": true,
      "defaultSort": "needed_by",
      "columns": [
        "item",
        "qty",
        "needed_by",
        {
          "name": "days_late",
          "computed": {
            "daysSince": "needed_by"
          },
          "when": {
            "days_late": {
              "gt": 0
            }
          }
        }
      ],
      "filter": {
        "shop_status": "needed"
      },
      "kind": "data"
    },
    {
      "name": "reward_shop",
      "sources": [
        "ref_rewards"
      ],
      "mode": "join",
      "layout": "card",
      "readonly": true,
      "defaultSort": "cost",
      "columns": [
        "reward",
        "cost"
      ],
      "icon": "mdi-gift",
      "kind": "data"
    },
    {
      "name": "reward_mine",
      "sources": [
        "reward_claim"
      ],
      "mode": "join",
      "layout": "table",
      "defaultSort": "claimed_on",
      "columns": [
        "claimed_on",
        "reward",
        "claim_status"
      ],
      "filter": {
        "person": "@me"
      },
      "icon": "mdi-gift-open",
      "kind": "data"
    },
    {
      "name": "reward_board",
      "sources": [
        "reward_claim"
      ],
      "mode": "join",
      "defaultSort": "claimed_on",
      "columns": [
        "person",
        "claimed_on"
      ],
      "hideEmpty": true,
      "board": {
        "lane": "claim_status",
        "lanes": [
          "requested",
          "granted",
          "denied"
        ],
        "title": "reward",
        "color": "person",
        "addInLane": true
      },
      "icon": "mdi-gift-open-outline",
      "kind": "board"
    }
  ],
  "nav": {
    "layout": "drawer",
    "items": [
      {
        "view": "doc_home"
      },
      {
        "view": "chore_board",
        "adminOnly": true
      },
      {
        "view": "doc_mine",
        "hideFromAdmin": true
      },
      {
        "view": "doc_scoreboard"
      },
      {
        "view": "reward_mine",
        "hideFromAdmin": true
      },
      {
        "view": "reward_board",
        "adminOnly": true
      },
      {
        "view": "shop_open"
      },
      {
        "view": "home_calendar"
      },
      {
        "group": "Household",
        "icon": "mdi-home-group",
        "adminOnly": true,
        "items": [
          {
            "view": "duty_matrix"
          },
          {
            "table": "tasks_ann"
          },
          {
            "table": "tasks_bob"
          },
          {
            "table": "tasks_cara"
          },
          {
            "table": "tasks_dan"
          }
        ]
      }
    ],
    "bottomNav": [
      "doc_home",
      "doc_mine",
      "doc_scoreboard",
      "shop_open"
    ]
  },
  "schemaVersion": 4
}
