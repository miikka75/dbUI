{
  "$schema": "../schema.schema.json",
  "schemaVersion": 4,
  "icons": {
    "favicon": "./examples/gym-favicon.svg"
  },
  "theme": {
    "light": {
      "primary": "#c62828",
      "secondary": "#ef6c00",
      "success": "#2e7d32"
    },
    "dark": {
      "primary": "#ef5350",
      "secondary": "#ffa726",
      "success": "#66bb6a"
    }
  },
  "defaultLanguage": "English",
  "translatableLists": [
    "booking_status",
    "attendance_status",
    "order_state",
    "membership_status",
    "pt_status",
    "coach_category",
    "coach_level",
    "ref_class_types",
    "ref_exercises",
    "ref_plans",
    "coach_format",
    "claim_status",
    "ref_rewards",
    "visit_check"
  ],
  "listSources": {
    "trainers": "userlink"
  },
  "newUser": {
    "role": "viewer",
    "tables": {
      "classes": "r",
      "news": "r",
      "coach_library": "r",
      "ref_gyms": "r",
      "ref_class_types": "r",
      "ref_plans": "r",
      "ref_exercises": "r",
      "ref_rewards": "r"
    }
  },
  "tables": {
    "ref_gyms": {
      "isLookup": true,
      "hierarchy": false,
      "columns": [
        {
          "name": "gym",
          "type": "text"
        },
        {
          "name": "address",
          "type": "text"
        },
        {
          "name": "opening_hours",
          "type": "text"
        },
        {
          "name": "code",
          "type": "text"
        }
      ]
    },
    "ref_class_types": {
      "isLookup": true,
      "hierarchy": false,
      "columns": [
        {
          "name": "class_type",
          "type": "text"
        },
        {
          "name": "duration_min",
          "type": "number"
        },
        {
          "name": "intensity",
          "type": "number"
        },
        {
          "name": "category",
          "type": "text"
        },
        {
          "name": "description",
          "type": "text"
        }
      ]
    },
    "ref_plans": {
      "isLookup": true,
      "hierarchy": false,
      "columns": [
        {
          "name": "plan",
          "type": "text"
        },
        {
          "name": "months",
          "type": "number"
        },
        {
          "name": "price_eur",
          "type": "number"
        },
        {
          "name": "pause_weeks",
          "type": "number"
        }
      ]
    },
    "ref_exercises": {
      "isLookup": true,
      "hierarchy": false,
      "columns": [
        {
          "name": "exercise",
          "type": "text"
        },
        {
          "name": "muscle_group",
          "type": "text"
        }
      ]
    },
    "classes": {
      "archivable": true,
      "defaultSort": "starts_at",
      "columns": [
        {
          "name": "starts_at",
          "type": "datetime"
        },
        {
          "name": "class_type",
          "type": "ref",
          "table": "ref_class_types",
          "valueCol": "class_type"
        },
        {
          "name": "gym",
          "type": "ref",
          "table": "ref_gyms",
          "valueCol": "gym"
        },
        {
          "name": "room",
          "type": "select",
          "list": "rooms",
          "allowNew": true,
          "sorted": true
        },
        {
          "name": "instructor",
          "type": "select",
          "list": "trainers",
          "allowNew": true,
          "sorted": true
        },
        {
          "name": "capacity",
          "type": "number"
        },
        {
          "name": "booked",
          "type": "number"
        },
        {
          "name": "walk_ins",
          "type": "number",
          "default": 0
        }
      ]
    },
    "bookings": {
      "privateRoster": true,
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "class",
          "type": "ref",
          "table": "classes",
          "valueCol": "id"
        },
        {
          "name": "booking",
          "type": "select",
          "list": "booking_status"
        },
        {
          "name": "attendance",
          "type": "select",
          "list": "attendance_status",
          "picker": "toggle",
          "default": "pending"
        },
        {
          "name": "checkin_code",
          "type": "text"
        },
        {
          "name": "class_start",
          "type": "datetime",
          "computed": {
            "lookup": {
              "table": "classes",
              "match": "class",
              "on": "id",
              "field": "starts_at"
            }
          }
        },
        {
          "name": "class_type",
          "computed": {
            "lookup": {
              "table": "classes",
              "match": "class",
              "on": "id",
              "field": "class_type"
            }
          }
        },
        {
          "name": "instructor",
          "computed": {
            "lookup": {
              "table": "classes",
              "match": "class",
              "on": "id",
              "field": "instructor"
            }
          }
        },
        {
          "name": "gym",
          "computed": {
            "lookup": {
              "table": "classes",
              "match": "class",
              "on": "id",
              "field": "gym"
            }
          }
        }
      ],
      "ownerWritable": [
        "class",
        "booking",
        "checkin_code"
      ],
      "ownerWritableWhile": {
        "attendance": "pending"
      },
      "capacity": {
        "link": "class",
        "status": "booking",
        "column": "capacity",
        "count": "booked",
        "holds": [
          "booked"
        ],
        "reserved": "walk_ins"
      }
    },
    "visits": {
      "privateRoster": true,
      "defaultSort": "visited_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "gym",
          "type": "ref",
          "table": "ref_gyms",
          "valueCol": "gym"
        },
        {
          "name": "visited_on",
          "type": "date"
        },
        {
          "name": "at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "door_code",
          "type": "text",
          "hidden": true
        },
        {
          "name": "verified",
          "type": "select",
          "list": "visit_check"
        }
      ],
      "ownerWritable": [
        "visited_on",
        "at",
        "door_code"
      ]
    },
    "workouts": {
      "privateRoster": true,
      "defaultSort": "done_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "done_on",
          "type": "date",
          "defaultFrom": "@today"
        },
        {
          "name": "exercise",
          "type": "ref",
          "table": "ref_exercises",
          "valueCol": "exercise"
        },
        {
          "name": "sets",
          "type": "number"
        },
        {
          "name": "reps",
          "type": "number"
        },
        {
          "name": "weight_kg",
          "type": "number"
        },
        {
          "name": "minutes",
          "type": "number"
        },
        {
          "name": "km",
          "type": "number"
        },
        {
          "name": "note",
          "type": "text"
        }
      ],
      "ownerWritable": [
        "done_on",
        "exercise",
        "sets",
        "reps",
        "weight_kg",
        "minutes",
        "km",
        "note"
      ]
    },
    "steps": {
      "privateRoster": true,
      "defaultSort": "day",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "day",
          "type": "date"
        },
        {
          "name": "step_count",
          "type": "number"
        }
      ],
      "ownerWritable": [
        "day",
        "step_count"
      ]
    },
    "memberships": {
      "privateRoster": true,
      "defaultSort": "start_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "plan",
          "type": "ref",
          "table": "ref_plans",
          "valueCol": "plan",
          "picker": "cards"
        },
        {
          "name": "start_on",
          "type": "date"
        },
        {
          "name": "order_state",
          "type": "select",
          "list": "order_state",
          "default": "draft"
        },
        {
          "name": "membership_status",
          "type": "select",
          "list": "membership_status",
          "picker": "chips",
          "default": "pending"
        },
        {
          "name": "pauses_used",
          "computed": {
            "count": "pauses",
            "on": "membership",
            "where": {
              "sent": "yes"
            }
          }
        },
        {
          "name": "valid_until",
          "computed": {
            "dateAdd": {
              "from": "start_on",
              "months": {
                "col": "plan.months"
              },
              "weeks": {
                "col": "pauses_used"
              },
              "days": -1
            }
          }
        }
      ],
      "ownerWritable": [
        "plan",
        "start_on",
        "order_state"
      ],
      "ownerWritableWhile": {
        "order_state": "draft"
      }
    },
    "pt_sessions": {
      "privateRoster": true,
      "defaultSort": "preferred_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "trainer",
          "type": "select",
          "list": "trainers",
          "sorted": true
        },
        {
          "name": "preferred_on",
          "type": "date"
        },
        {
          "name": "goal",
          "type": "text"
        },
        {
          "name": "pt_status",
          "type": "select",
          "list": "pt_status",
          "picker": "chips",
          "default": "requested"
        },
        {
          "name": "trainer_notes",
          "type": "text"
        }
      ],
      "ownerWritable": [
        "trainer",
        "preferred_on",
        "goal"
      ],
      "ownerWritableWhile": {
        "pt_status": "requested"
      }
    },
    "news": {
      "archivable": true,
      "defaultSort": "published_on",
      "columns": [
        {
          "name": "published_on",
          "type": "date"
        },
        {
          "name": "headline",
          "type": "text"
        },
        {
          "name": "body",
          "type": "text"
        },
        {
          "name": "picture",
          "type": "image"
        }
      ]
    },
    "coach_library": {
      "defaultSort": "title",
      "columns": [
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "format",
          "type": "select",
          "list": "coach_format",
          "picker": "chips"
        },
        {
          "name": "weeks",
          "type": "number"
        },
        {
          "name": "equipment",
          "type": "text"
        },
        {
          "name": "category",
          "type": "select",
          "list": "coach_category"
        },
        {
          "name": "level",
          "type": "select",
          "list": "coach_level",
          "picker": "chips"
        },
        {
          "name": "minutes",
          "type": "number"
        },
        {
          "name": "video",
          "type": "url"
        },
        {
          "name": "thumbnail",
          "type": "image"
        }
      ]
    },
    "ref_rewards": {
      "isLookup": true,
      "hierarchy": false,
      "columns": [
        {
          "name": "reward",
          "type": "text"
        },
        {
          "name": "category",
          "type": "text"
        },
        {
          "name": "cost",
          "type": "number"
        },
        {
          "name": "details",
          "type": "text"
        }
      ]
    },
    "reward_claims": {
      "privateRoster": true,
      "archivable": true,
      "defaultSort": "claimed_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "reward",
          "type": "ref",
          "table": "ref_rewards",
          "valueCol": "reward",
          "picker": "cards",
          "enabledWhen": {
            "cost": {
              "lte": {
                "view": "coin_spendable",
                "field": "coins"
              }
            }
          }
        },
        {
          "name": "claimed_on",
          "type": "date"
        },
        {
          "name": "sent",
          "type": "text",
          "hidden": true
        },
        {
          "name": "claim_status",
          "type": "select",
          "list": "claim_status",
          "picker": "toggle",
          "default": "requested"
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "ownerWritable": [
        "reward",
        "claimed_on",
        "sent"
      ],
      "ownerWritableWhile": {
        "claim_status": "requested"
      },
      "archiveAfter": {
        "column": "claim_status",
        "values": [
          "granted",
          "denied"
        ],
        "days": 1
      }
    },
    "pauses": {
      "privateRoster": true,
      "defaultSort": "starts_on",
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "membership",
          "type": "ref",
          "table": "memberships",
          "valueCol": "id",
          "label": [
            "plan",
            "start_on"
          ],
          "listFilter": {
            "order_state": "submitted",
            "membership_status": {
              "ne": "ended"
            }
          }
        },
        {
          "name": "starts_on",
          "type": "date"
        },
        {
          "name": "sent",
          "type": "text",
          "hidden": true
        },
        {
          "name": "pause_until",
          "computed": {
            "dateAdd": {
              "from": "starts_on",
              "days": 6
            }
          }
        }
      ],
      "ownerWritable": [
        "membership",
        "starts_on",
        "sent"
      ],
      "ownerWritableWhile": {
        "sent": ""
      }
    },
    "feed_subs": {
      "privateRoster": true,
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "lang",
          "type": "text"
        },
        {
          "name": "active",
          "type": "text"
        },
        {
          "name": "fid",
          "type": "text"
        },
        {
          "name": "url",
          "type": "text"
        }
      ],
      "ownerWritable": [
        "lang",
        "active"
      ],
      "ownerWritableWhile": {
        "active": "yes"
      }
    }
  },
  "views": [
    {
      "name": "doc_home",
      "kind": "page",
      "icon": "mdi-home",
      "fab": "scan",
      "markdown": "# {{t:text.home_heading}}\n\n{{view:my_level}}\n\n## {{t:text.home_month}}\n\n{{view:my_pulse}}\n\n## {{t:text.home_news}}\n\n{{view:news_feed}}\n"
    },
    {
      "name": "visit_scan",
      "kind": "scan",
      "icon": "mdi-qrcode-scan",
      "sources": [
        "visits"
      ],
      "mode": "union",
      "defaultSort": "visited_on",
      "filter": {
        "owner": "@me"
      },
      "columns": [
        "visited_on",
        "gym",
        "verified"
      ],
      "scan": {
        "column": "gym",
        "codeCol": "code",
        "set": {
          "visited_on": "@today",
          "at": "@now"
        },
        "label": "text.door_code",
        "verify": {
          "claim": "door_code",
          "set": {
            "verified": "yes"
          },
          "rotateMinutes": 5
        },
        "blockedBy": {
          "table": "pauses",
          "from": "starts_on",
          "to": "pause_until",
          "where": {
            "sent": "yes"
          },
          "message": "text.paused"
        },
        "requires": {
          "table": "memberships",
          "from": "start_on",
          "to": "valid_until",
          "where": {
            "$or": [
              {
                "membership_status": "active"
              },
              {
                "membership_status": "paused"
              }
            ]
          },
          "message": "text.no_membership"
        }
      }
    },
    {
      "name": "class_booking",
      "kind": "rsvp",
      "icon": "mdi-calendar-check",
      "fab": "scan",
      "rsvp": {
        "events": "classes",
        "dateColumn": "starts_at",
        "titleColumns": [
          "class_type",
          "instructor",
          "gym"
        ],
        "responses": "bookings",
        "statusColumn": "booking",
        "picker": "toggle",
        "showCounts": true,
        "rosterVisibility": "admins",
        "checkin": {
          "codeColumn": "checkin_code",
          "set": {
            "attendance": "attended"
          },
          "rotateMinutes": 5,
          "link": "submit"
        },
        "closeBefore": 30,
        "blockedBy": {
          "table": "pauses",
          "from": "starts_on",
          "to": "pause_until",
          "where": {
            "sent": "yes"
          },
          "message": "text.paused"
        },
        "requires": {
          "table": "memberships",
          "from": "start_on",
          "to": "valid_until",
          "where": {
            "$or": [
              {
                "membership_status": "active"
              },
              {
                "membership_status": "paused"
              }
            ]
          },
          "message": "text.no_membership"
        }
      }
    },
    {
      "name": "class_calendar",
      "kind": "calendar",
      "icon": "mdi-calendar-month",
      "fab": "scan",
      "calendar": {
        "sources": [
          {
            "table": "classes",
            "dateColumn": "starts_at",
            "titleColumns": [
              "class_type",
              "instructor",
              "gym"
            ],
            "label": "Class",
            "respond": "class_booking"
          }
        ],
        "defaultView": "week",
        "weekStart": 1,
        "filters": [
          "gym"
        ],
        "export": false
      }
    },
    {
      "name": "my_pulse",
      "kind": "stats",
      "icon": "mdi-gauge",
      "sources": [
        "visits",
        "workouts"
      ],
      "mode": "union",
      "filter": {
        "owner": "@me"
      },
      "readonly": true,
      "stats": {
        "tiles": [
          {
            "label": "text.streak_gym",
            "agg": "streak",
            "column": "visited_on",
            "interval": "weekly",
            "icons": [
              {
                "at": 1,
                "icon": "mdi-sprout"
              },
              {
                "at": 3,
                "icon": "mdi-fire"
              },
              {
                "at": 8,
                "icon": "mdi-trophy"
              },
              {
                "at": 26,
                "icon": "mdi-crown"
              }
            ],
            "when": {
              "verified": "yes"
            }
          },
          {
            "label": "text.pulse_visits_month",
            "agg": "count",
            "when": {
              "visited_on": {
                "within": "@month"
              },
              "verified": "yes"
            }
          },
          {
            "label": "text.pulse_workouts_week",
            "agg": "count",
            "when": {
              "done_on": {
                "within": "@week"
              }
            }
          },
          {
            "label": "text.pulse_minutes_month",
            "agg": "sum",
            "column": "minutes",
            "when": {
              "done_on": {
                "within": "@month"
              }
            }
          },
          {
            "label": "text.pulse_km_week",
            "agg": "sum",
            "column": "km",
            "when": {
              "done_on": {
                "within": "@week"
              }
            }
          }
        ],
        "display": "number"
      }
    },
    {
      "name": "my_period_totals",
      "kind": "stats",
      "icon": "mdi-sigma",
      "sources": [
        "workouts",
        "visits"
      ],
      "mode": "union",
      "filter": {
        "$and": [
          {
            "owner": "@me"
          },
          {
            "$or": [
              {
                "done_on": {
                  "within": {
                    "calendar": "my_calendar"
                  }
                }
              },
              {
                "visited_on": {
                  "within": {
                    "calendar": "my_calendar"
                  }
                }
              }
            ]
          }
        ]
      },
      "readonly": true,
      "stats": {
        "tiles": [
          {
            "label": "text.total_hours",
            "agg": "sum",
            "column": "minutes",
            "divide": 60,
            "decimals": 1
          },
          {
            "label": "text.total_exercises",
            "agg": "count",
            "when": {
              "done_on": {
                "notEmpty": true
              }
            }
          },
          {
            "label": "text.total_visits",
            "agg": "count",
            "when": {
              "visited_on": {
                "notEmpty": true
              },
              "verified": "yes"
            }
          },
          {
            "label": "text.total_km",
            "agg": "sum",
            "column": "km"
          }
        ],
        "display": "number"
      }
    },
    {
      "name": "my_steps_week",
      "kind": "stats",
      "icon": "mdi-shoe-print",
      "sources": [
        "steps"
      ],
      "mode": "union",
      "filter": {
        "owner": "@me",
        "day": {
          "within": {
            "calendar": "my_calendar"
          }
        }
      },
      "readonly": true,
      "stats": {
        "tiles": [
          {
            "label": "text.steps_total",
            "agg": "sum",
            "column": "step_count"
          },
          {
            "label": "text.steps_avg",
            "agg": "avg",
            "column": "step_count",
            "decimals": 0
          }
        ],
        "display": "number"
      }
    },
    {
      "name": "my_top_exercises",
      "kind": "stats",
      "icon": "mdi-podium",
      "sources": [
        "workouts"
      ],
      "mode": "union",
      "groupBy": {
        "column": "exercise",
        "from": [
          "exercise"
        ]
      },
      "aggregate": {
        "count": true,
