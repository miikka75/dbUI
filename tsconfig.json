{
  "// why": [
    "Type-checking WITHOUT a build step: allowJs + checkJs + noEmit means tsc reads the shipped .js",
    "directly and emits nothing, so index.html keeps loading the same plain <script src> files.",
    "Run it with `npm run typecheck` from dev/.",
    "",
    "Scope: every top-level module but the ones dev/test/typecheck-scope.test.js lists as outside it."
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2017",
    "module": "commonjs",
    "lib": [
      "es2020",
      "dom"
    ],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "columns.js",
    "access-features.js",
    "list-access.js",
    "list-users.js",
    "calendar.js",
    "rotation.js",
    "query.js",
    "migrations.js",
    "schema-normalize.js",
    "examples.js",
    "writes.js",
    "rows.js",
    "embeds.js",
    "events.js",
    "ics.js",
    "feeds.js",
    "timeline.js",
    "print.js",
    "pivot.js",
    "rsvp.js",
    "board.js",
    "nav.js",
    "scan.js",
    "leftovers.js",
    "live-sync.js",
    "backend-helpers.js",
    "csp.js",
    "stats.js",
    "form.js",
    "brand.js",
    "reorder.js",
    "profiles.js",
    "images.js",
    "bundle.js",
    "undo.js",
    "csp-client.js",
    "databases.js",
    "backend-kv.js",
    "storage-supabase.js"
  ]
}
