rules_version = '2';

// Firebase Storage rules for the image column uploader (backend-firebase uploadFile).
// Files live under uploads/<lowercased-user-email>/<ts>_<name>. A user may write only their OWN
// folder (image/* under 10 MB); any signed-in user may read. Note: the download URL the app stores
// carries an access token that lets <img> load the file even independent of these read rules.
//
// Writes additionally require REGISTRATION (a cross-service Firestore lookup): with the Google
// provider enabled, "signed in" alone means any Google account on the internet — and the Firebase
// config is distributed by shareable links — so an unregistered gate-less bucket is free image
// hosting for strangers. Mirrors firestore.rules' userData(): the per-user /_users doc first, the
// legacy _meta/users map as fallback. Bootstrap needs no carve-out here: the first user is
// auto-registered as admin at boot, before any upload is possible.
service firebase.storage {
  match /b/{bucket}/o {
    // Email passed as an argument: a path segment interpolates a variable ($(email)), not a call.
    function isRegistered(email) {
      return firestore.exists(/databases/(default)/documents/_users/$(email))
          || (firestore.exists(/databases/(default)/documents/_meta/users)
              && email in firestore.get(/databases/(default)/documents/_meta/users).data);
    }
    match /uploads/{userEmail}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email.lower() == userEmail
                   && isRegistered(userEmail)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.token.email.lower() == userEmail
                    && isRegistered(userEmail);
    }
  }
}
