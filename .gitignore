node_modules/
# Any dev-server SQLite database, not just the default one: APP_DB=<name>.db runs an isolated instance
# (see dev/server.js), and every such file holds real row data.
dev/*.db
dev/*.db-wal
dev/*.db-shm
test-results/
playwright-report/

# dev-server runtime persistence (real user/role/profile/request data — never commit). The `*.` forms
# are the per-database sidecars an isolated APP_DB instance writes (chores-demo.db -> chores-demo.users.json).
dev/users.json
dev/access-requests.json
dev/profiles.json
dev/*.users.json
dev/*.access-requests.json
dev/*.profiles.json
dev/data/
dev/uploads/

# Data exports / import bundles dropped in the repo root. These carry real ROW data (the `tables` key
# of an export bundle), and firebase.json hosts the repo root — so an un-ignored one is both one
# `git add -A` from history and one `firebase deploy` from being world-readable. The hosting `ignore`
# list refuses them too; keep the two in step.
/drive-sync-export-*.json
/*-import.json
/*-export.json



# firebase emulator logs
firebase-debug.log
firestore-debug.log

# firebase hosting deploy cache (local, machine-specific — regenerated each deploy)
.firebase/

# vendored third-party dists (Vue/Vuetify/MDI) are GENERATED, not committed. The web SessionStart hook
# (.claude/hooks/session-start.sh) materialises them into /vendor from npm; locally ./update-vendor.sh
# pulls the pinned versions from the CDN. The app loads them from /vendor at runtime and falls back to
# the SRI-pinned jsdelivr CDN (index.html loadScript/loadStyle, validated by `npm run test:cdn`) when
# they're absent — so production and the offline UI/E2E suites work either way. Only vendor/versions is
# tracked (it pins the versions both the hook and update-vendor.sh fetch).
/vendor/*
!/vendor/versions

# Cloud Functions deps (functions/ deploys its own node_modules)
functions/node_modules/

# Local browser-preview launch config (per-machine tooling)
.claude/launch.json
