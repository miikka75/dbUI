node_modules/
dev/local.db
dev/local.db-wal
dev/local.db-shm
test-results/
playwright-report/

# dev-server runtime persistence (real user/role/profile/request data — never commit)
dev/users.json
dev/access-requests.json
dev/profiles.json
dev/data/
dev/uploads/

# throwaway seed / test databases (see seed-demo.js)
dev/seed-test-*.db
dev/seed-test-*.db-wal
dev/seed-test-*.db-shm


# firebase emulator logs
firebase-debug.log
firestore-debug.log

# firebase hosting deploy cache (local, machine-specific — regenerated each deploy)
.firebase/

# vendored third-party dists (Vue/Vuetify/MDI) are COMMITTED so the app is self-hosted: it loads them
# from /vendor at runtime with no external request, and the E2E/UI suites run with no network access.
# Refresh them with ./update-vendor.sh (pulls the pinned versions from the CDN) and commit the result.
# The SRI-pinned CDN URLs in index.html/style.html remain as a resilience fallback and are validated
# separately by `npm run test:cdn` (the `cdn-fallback` CI job), not exercised by the functional suites.

# Cloud Functions deps (functions/ deploys its own node_modules)
functions/node_modules/
