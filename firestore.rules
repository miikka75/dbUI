rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function noUsers() { return !exists(/databases/$(database)/documents/_meta/users); }
    function myEmail() { return request.auth.token.email.lower(); }
    // Per-user access lives in /_users/<lowercased-email>. Fall back to the legacy _meta/users map
    // (privileged get() — bypasses read rules) for users not yet migrated, so there is no lockout
    // during rollout. Only evaluated when noUsers() is false (callers short-circuit on bootstrap),
    // so the fallback get() never runs against a missing _meta/users doc.
    function userData() {
      return exists(/databases/$(database)/documents/_users/$(myEmail()))
        ? get(/databases/$(database)/documents/_users/$(myEmail())).data
        : get(/databases/$(database)/documents/_meta/users).data[myEmail()];
    }
    function role() { return noUsers() ? 'admin' : (userData() != null ? userData().role : null); } // bootstrap = admin
    function isRegistered() { return noUsers() || userData() != null; }
    function hasTableAccess(collection) {
      let table = collection.split('__')[0];
      return userData().tables == 'all' || table in userData().tables;
    }
    function listAllowed() {
      return userData().tables == 'all' || userData().tables.hasAny(resource.data.tables);
    }

    // Meta: read by registered. `lists` and `users` docs are admin-only reads (users holds every
    // member's email/role/grants; per-user access now lives in /_users). Write by admin (or bootstrap).
    // Editors no longer write here: per-list storage moved to /_lists (its own rule below), so the old
    // editor branch on the legacy lists doc only allowed clobbering lists outside their table grants.
    match /_meta/{doc} {
      allow read: if request.auth != null && isRegistered() && (
        (doc != 'lists' && doc != 'users') || noUsers() || role() == 'admin'
      );
      allow create, update: if request.auth != null && (noUsers() || role() == 'admin');
      // The bootstrap probe is exists(_meta/users): deleting that doc while /_users docs exist would
      // flip noUsers() true and hand EVERY signed-in Google account full admin. Nobody deletes it —
      // an admin resetting the registry overwrites it with {} instead (exists() stays true).
      allow delete: if request.auth != null && doc != 'users' && (noUsers() || role() == 'admin');
    }

    // Per-user access docs: a user reads only their OWN doc; admins read/list/write all. Replaces the
    // single _meta/users map for reads so a restricted user can learn their own access without seeing
    // everyone else's email/role/grants.
    match /_users/{email} {
      allow read: if request.auth != null && (noUsers() || myEmail() == email || role() == 'admin');
      allow write: if request.auth != null && (noUsers() || role() == 'admin');
    }

    // Membership requests: a signed-in but unregistered user may create/read/withdraw ONLY their own
    // request doc; admins read/list/delete all. The request is inert until an admin approves it by
    // writing a /_users doc (the role/tables are the admin's choice, never the requester's).
    match /_access_requests/{email} {
      // Shape-validate the self-create (mirrors _profiles): requestAccess writes exactly
      // { email, name, note, ts }, so an arbitrary signed-in account can't park an oversized or
      // wrong-shaped doc here (these render in the admin's approval UI).
      function validRequest() {
        return request.resource.data.keys().hasOnly(['email', 'name', 'note', 'ts'])
          && request.resource.data.email == email
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
          && (!('ts' in request.resource.data) || request.resource.data.ts is number);
      }
      allow read, delete: if request.auth != null && myEmail() == email;
      allow create:       if request.auth != null && myEmail() == email && validRequest();
      allow read, write:  if request.auth != null && !noUsers() && role() == 'admin';
    }

    // Opt-in display-name profiles. A user reads/writes ONLY their own doc; a profile with
    // shared==true is readable by any registered user (so `.where('shared','==',true)` — which IS
    // query-provable, unlike an intersection — can populate a user-backed name list). Admins read all.
    match /_profiles/{email} {
      // A profile is exactly { name: <string>, shared: <bool> } (setProfileName merges name only).
      // Validate on create/update so a self-write can't store an oversized or wrong-typed name -- these
      // display names feed user-backed lists and the roster, so junk here poisons those.
      function validProfile() {
        return request.resource.data.keys().hasOnly(['name', 'shared'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && (!('shared' in request.resource.data) || request.resource.data.shared is bool);
      }
      allow read:           if request.auth != null && (resource.data.shared == true || myEmail() == email || (!noUsers() && role() == 'admin'));
      allow create, update: if request.auth != null && (myEmail() == email || (!noUsers() && role() == 'admin')) && validProfile();
      allow delete:         if request.auth != null && (myEmail() == email || (!noUsers() && role() == 'admin'));
    }

    // Per-list storage: each list is its own doc carrying its owning `tables`. Read/write gated on
    // whether the user has access to any owning table (admins/bootstrap unrestricted). An editor may
    // change a list's ITEMS but not its `tables` ownership label — that determines who can see the list,
    // so re-stamping it stays an admin action (listAllowed() reads resource, so the editor branch is
    // update-only anyway; the equality just pins the field). Admins/bootstrap set `tables` freely.
    match /_lists/{listName} {
      allow read: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' || listAllowed()
      );
      allow write: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' ||
        (role() == 'editor' && listAllowed() && request.resource.data.tables == resource.data.tables)
      );
    }

    // Doc-view bodies (savePage/loadPage -> putRow('_pages', …) -> _pages__active). Content PAGES, not
    // row data: readable by EVERY registered user — a page's embeds are resolved client-side and each
    // embedded table's rows stay gated by their own rules, so the body text is the only thing exposed.
    // Writable by admins/editors. Previously governed by the data catch-all, whose
    // hasTableAccess('_pages') gate no grant ever satisfies (access-features never emits '_pages'), so
    // restricted members were silently served the stale schema-seeded markdown instead of the edited body.
    match /_pages__active/{doc} {
      allow read:  if request.auth != null && isRegistered();
      allow write: if request.auth != null && (noUsers() || role() == 'admin' || role() == 'editor');
    }

    // Data tables (never _meta or _lists). Read needs table access. Writes split into create/update/delete
    // so OWNER-SCOPED self-service rows work: a registered member may create/edit/delete ONLY their own
    // row (one carrying `owner == their email`), no table-editor grant required — this backs the RSVP /
    // sign-up pattern. Rows without an `owner` field keep the plain per-table editor gate. Admins write all.
    // The data catch-all must NOT also match a system collection, or its permissive owner-create branch
    // (`request.resource.data.owner == myEmail()`) lets ANY registered user mint e.g. an _users doc with
    // role:'admin' — a privilege escalation, since role() reads that doc. Firestore ORs overlapping match
    // blocks, so naming only _meta/_lists here left _users/_profiles/_access_requests reachable through
    // this rule. Exclude the whole underscore namespace (fail-safe: a future system collection is denied
    // here by default and must get its own block — _pages__active has one above).
    function base(coll) { return request.auth != null && isRegistered() && !coll.matches('^_.*'); }
    // Self-service is bounded to tables that DECLARE an owner column -- mirrored to _meta/ownerTables by
    // saveSchema (BackendHelpers.ownerTablesOf). Without this, owner-create was allowed on ANY table, so a
    // registered member could inject owner-stamped junk rows into tables never meant for self-service.
    // Migration: if the doc doesn't exist yet (rules deployed before the schema was re-saved), fall back to
    // permissive so existing sign-up flows don't break -- enforcement activates on the next schema save.
    function selfServiceTable(coll) {
      return !exists(/databases/$(database)/documents/_meta/ownerTables)
        || (coll.split('__')[0] in get(/databases/$(database)/documents/_meta/ownerTables).data.tables);
    }
    match /{collection}/{doc} {
      // Read: owner-stamped rows are private to their owner UNLESS marked rosterPublic (a per-table policy
      // denormalized onto each row) — members self-serve without a table grant and read only their own,
      // while a public roster is readable by all and organizers (table grant) / admins read every row.
      // Non-owner rows keep the plain per-table gate.
      allow read: if base(collection) && (
        noUsers() || role() == 'admin' ||
        (('owner' in resource.data)
          ? (resource.data.owner == myEmail() || resource.data.rosterPublic == true || hasTableAccess(collection))
          : hasTableAccess(collection))
      );
      allow create: if base(collection) && (
        noUsers() || role() == 'admin' ||
        (request.resource.data.owner == myEmail() && selfServiceTable(collection)) || // self-service: my own row, only on an owner-column table
        (role() == 'editor' && hasTableAccess(collection))
      );
      allow update: if base(collection) && (
        noUsers() || role() == 'admin' ||
        // edit my own (can't reassign owner) — bounded to owner-column tables like create, so a stray
        // owner-stamped row in a non-self-service table doesn't stay member-editable forever
        (resource.data.owner == myEmail() && request.resource.data.owner == myEmail() && selfServiceTable(collection)) ||
        (role() == 'editor' && hasTableAccess(collection))
      );
      allow delete: if base(collection) && (
        noUsers() || role() == 'admin' ||
        (resource.data.owner == myEmail() && selfServiceTable(collection)) || // delete my own owned row (self-service tables only)
        (role() == 'editor' && hasTableAccess(collection))
      );
    }
  }
}
