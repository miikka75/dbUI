rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function noUsers() { return !exists(/databases/$(database)/documents/_meta/users); }
    function myEmail() { return request.auth.token.email.lower(); }
    // Per-user access lives in /_users/<lowercased-email>. Fall back to the legacy _meta/users map
    // (privileged get() — bypasses read rules) for users not yet migrated, so there is no lockout
    // during rollout. Only evaluated when noUsers() is false (callers short-circuit on bootstrap),
    // so the fallback get() never runs against a missing _meta/users doc.
    function userData() {
      return exists(/databases/$(database)/documents/_users/$(myEmail()))
        ? get(/databases/$(database)/documents/_users/$(myEmail())).data
        : get(/databases/$(database)/documents/_meta/users).data[myEmail()];
    }
    function role() { return noUsers() ? 'admin' : (userData() != null ? userData().role : null); } // bootstrap = admin
    function isRegistered() { return noUsers() || userData() != null; }
    // --- Grants. `tables` is 'all', a LEGACY list of names (read+write on each), or a map
    // { table: 'r' | 'rw' } where 'r' is read-but-not-write (reference data an editor should see and
    // not change). READ membership is identical for both containers — `x in <list>` matches an element
    // and `x in <map>` matches a key — so the read gates below are untouched and no stored grant needs
    // migrating. WRITE reads a denormalized `rwTables` list written alongside the grant (same trick as
    // _meta/ownerTables and the per-row rosterPublic flag: rules can't filter a map, so the writable
    // subset is materialized at write time). A doc with no `rwTables` predates the split — fall back to
    // plain membership so every existing grant keeps working. ---
    function hasTableAccess(collection) {
      let table = collection.split('__')[0];
      return userData().tables == 'all' || table in userData().tables;
    }
    // The no-`rwTables` fallback is for grants written BEFORE the split — and those are legacy LISTS,
    // since the map shape arrived with the very change that introduced rwTables. Restricting the
    // fallback to a list is therefore lossless for real legacy data, and closes a map without the
    // mirror (hand-edited, or written by something that skipped userGrantDoc) silently promoting every
    // 'r' grant to 'rw'.
    function hasTableWrite(collection) {
      let table = collection.split('__')[0];
      let u = userData();
      return u.tables == 'all'
        || ('rwTables' in u ? table in u.rwTables : (u.tables is list && table in u.tables));
    }
    function listAllowed() {
      let t = userData().tables;
      return t == 'all' || (t is list && t.hasAny(resource.data.tables))
                        || (t is map && t.keys().hasAny(resource.data.tables));
    }

    // Meta: read by registered. `lists` and `users` docs are admin-only reads (users holds every
    // member's email/role/grants; per-user access now lives in /_users). Write by admin (or bootstrap).
    // Editors no longer write here: per-list storage moved to /_lists (its own rule below), so the old
    // editor branch on the legacy lists doc only allowed clobbering lists outside their table grants.
    match /_meta/{doc} {
      allow read: if request.auth != null && isRegistered() && (
        (doc != 'lists' && doc != 'users') || noUsers() || role() == 'admin'
      );
      allow create, update: if request.auth != null && (noUsers() || role() == 'admin');
      // The bootstrap probe is exists(_meta/users): deleting that doc while /_users docs exist would
      // flip noUsers() true and hand EVERY signed-in Google account full admin. Nobody deletes it —
      // an admin resetting the registry overwrites it with {} instead (exists() stays true).
      allow delete: if request.auth != null && doc != 'users' && (noUsers() || role() == 'admin');
    }

    // Per-user access docs: a user reads only their OWN doc; admins read/list/write all. Replaces the
    // single _meta/users map for reads so a restricted user can learn their own access without seeing
    // everyone else's email/role/grants.
    match /_users/{email} {
      allow read: if request.auth != null && (noUsers() || myEmail() == email || role() == 'admin');
      allow write: if request.auth != null && (noUsers() || role() == 'admin');
    }

    // Membership requests: a signed-in but unregistered user may create/read/withdraw ONLY their own
    // request doc; admins read/list/delete all. The request is inert until an admin approves it by
    // writing a /_users doc (the role/tables are the admin's choice, never the requester's).
    match /_access_requests/{email} {
      // Shape-validate the self-create (mirrors _profiles): requestAccess writes exactly
      // { email, name, note, ts }, so an arbitrary signed-in account can't park an oversized or
      // wrong-shaped doc here (these render in the admin's approval UI).
      function validRequest() {
        return request.resource.data.keys().hasOnly(['email', 'name', 'note', 'ts'])
          && request.resource.data.email == email
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
          && (!('ts' in request.resource.data) || request.resource.data.ts is number);
      }
      allow read, delete: if request.auth != null && myEmail() == email;
      allow create:       if request.auth != null && myEmail() == email && validRequest();
      allow read, write:  if request.auth != null && !noUsers() && role() == 'admin';
    }

    // Opt-in display-name profiles. A user reads/writes ONLY their own doc; a profile with
    // shared==true is readable by any registered user (so `.where('shared','==',true)` — which IS
    // query-provable, unlike an intersection — can populate a user-backed name list). Admins read all.
    match /_profiles/{email} {
      // A profile is exactly { name: <string>, shared: <bool>, picture: <string> } (setProfileName merges
      // name only; picture is an optional self-uploaded data-URL avatar, resized client-side). Validate on
      // create/update so a self-write can't store an oversized or wrong-typed name -- these display names
      // feed user-backed lists and the roster, so junk here poisons those. The picture is capped at ~350KB
      // (data-URL chars) so a profile doc stays comfortably under Firestore's 1MB document limit.
      function validProfile() {
        return request.resource.data.keys().hasOnly(['name', 'shared', 'picture'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && (!('shared' in request.resource.data) || request.resource.data.shared is bool)
          && (!('picture' in request.resource.data) || (request.resource.data.picture is string && request.resource.data.picture.size() <= 350000));
      }
      allow read:           if request.auth != null && (resource.data.shared == true || myEmail() == email || (!noUsers() && role() == 'admin'));
      allow create, update: if request.auth != null && (myEmail() == email || (!noUsers() && role() == 'admin')) && validProfile();
      allow delete:         if request.auth != null && (myEmail() == email || (!noUsers() && role() == 'admin'));
    }

    // Per-list storage: each list is its own doc carrying its owning `tables`. READ is gated on access to
    // any owning table (admins/bootstrap unrestricted). WRITE is admin-only except for the lists the
    // schema opens — see listUserWritable below. Whoever writes, the `tables` ownership LABEL is
    // pinned: it decides who can see the list, so re-stamping it stays an admin action. On an update the
    // pin is `request.resource.data.tables == resource.data.tables`; on a CREATE there is no stored doc
    // to compare against — `resource` is null — so the label is an unverified claim and is pinned to
    // _meta/listTables instead (the schema-derived ownership map, listOwnershipMap, mirrored by
    // saveSchema). Without that, a non-admin could mint a list under an ownership label of their
    // choosing and hijack the read audience of a list another table actually owns. This matters in
    // practice: putListItem on a list whose doc doesn't exist yet IS a create (set with merge).
    function listTablesMap() {
      return exists(/databases/$(database)/documents/_meta/listTables)
        ? get(/databases/$(database)/documents/_meta/listTables).data : {};
    }
    // Editing a list is editing SHARED VOCABULARY — the member names, the status words every view reads
    // — so it is admin-only unless the schema names the list in `userWritableLists` (mirrored to
    // _meta/listWritable), which marks the free-form vocabularies any registered user maintains as they
    // work. A table grant is deliberately NOT consulted: a list belongs to every table whose columns
    // reference it, so keying on the grant handed one rw table every list its columns touched.
    // No mirror doc -> no list is user-writable, which is the safe default: a deployment that has not
    // re-saved its schema cannot silently keep the old behaviour.
    function listUserWritable(listName) {
      return exists(/databases/$(database)/documents/_meta/listWritable)
        && get(/databases/$(database)/documents/_meta/listWritable).data.lists.hasAny([listName]);
    }
    // The ownership label on a CREATE is an unverified claim (there is no stored doc to compare against),
    // so pin it to the schema-derived mirror: the list must be one the schema knows, and the label must
    // be exactly what the schema says. No mirror doc yet -> no non-admin creates, and the feature
    // activates on the next saveSchema.
    function listLabelPinned(listName) {
      let m = listTablesMap();
      return (listName in m) && request.resource.data.tables == m[listName];
    }
    match /_lists/{listName} {
      allow read: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' || listAllowed()
      );
      // Editing a list is admin-only, EXCEPT the lists the schema opens (userWritableLists): those are
      // free-form vocabularies any registered user maintains as they work. A table grant is deliberately
      // not consulted — a list belongs to every table whose columns reference it, so keying on the grant
      // handed one rw table every list its columns touched (`members` via home_shopping.added_by).
      // The ownership LABEL is still pinned either way: to the schema mirror on create (where the label
      // is an unverified claim) and to its stored value on update, so nobody mints or re-points a list
      // under a label of their choosing and hijacks another list's read audience.
      allow create: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' || (listUserWritable(listName) && listLabelPinned(listName))
      );
      allow update: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' ||
        (listUserWritable(listName) && request.resource.data.tables == resource.data.tables)
      );
      // Deleting a list is pruning, which only the full-view holder can judge (saveLists prunes only
      // when _myTables() is null). Stated as its own rule rather than riding `write`, where the
      // re-stamp pin referenced a null request.resource and denied editors by evaluation error.
      allow delete: if request.auth != null && isRegistered() && (noUsers() || role() == 'admin');
    }

    // User-linked lists (Option C): each doc links a list VALUE to a registered user's email so a cell can
    // show that user's avatar. `shared` caches whether the linked user currently shares their profile, so a
    // non-admin can query ONLY the shared links (`.where('shared','==',true)`) — those emails are already
    // world-readable via /_profiles, so this exposes nothing new. An unshared link is admin-only. Only
    // admins write. Same shape as /_profiles, so it never falls through to the data catch-all (which
    // excludes the whole `_` namespace anyway).
    // A user may also read the link that names THEM (`email == myEmail()`), which is how `@me` resolves
    // to a curated list value on a `userlink` list. That is the caller's own identity — no new exposure
    // — and the constant comparison makes `.where('email','==',<my email>)` rules-provable, the same
    // property that lets a non-admin run the shared-links query.
    match /_list_users/{id} {
      function validLink() {
        return request.resource.data.keys().hasOnly(['list', 'value', 'email', 'shared'])
          && request.resource.data.list is string && request.resource.data.list.size() <= 200
          && request.resource.data.value is string && request.resource.data.value.size() <= 500
          && request.resource.data.email is string && request.resource.data.email.size() <= 320
          && request.resource.data.shared is bool;
      }
      allow read:           if request.auth != null && (resource.data.shared == true || resource.data.email == myEmail() || (!noUsers() && role() == 'admin'));
      allow create, update: if request.auth != null && (noUsers() || role() == 'admin') && validLink();
      allow delete:         if request.auth != null && (noUsers() || role() == 'admin');
    }

    // Doc-view bodies (savePage/loadPage -> putRow('_pages', …) -> _pages__active). Content PAGES, not
    // row data: a page's embeds are resolved client-side and each embedded table's rows stay gated by
    // their own rules, so the body text is the only thing exposed. Writable by admins/editors.
    //
    // Read defaults to EVERY registered user, but a page may declare `access: [tables]` in the schema
    // ("visible to users granted any of these tables"), mirrored to _meta/pageAccess by saveSchema
    // (BackendHelpers.pageAccessOf) since rules can't read the schema. Reused table grants = no new
    // permission type. loadPage reads a SINGLE page doc (rules aren't filters -> a whole-collection read
    // would be denied once any page is restricted). Untagged pages keep the all-registered default.
    // NOTE: this protects the stored (edited) body; the schema-defined seed markdown is in the schema
    // doc every registered user reads, so don't put secrets in a restricted page's schema seed.
    function pageAccessMap() {
      return exists(/databases/$(database)/documents/_meta/pageAccess)
        ? get(/databases/$(database)/documents/_meta/pageAccess).data : {};
    }
    // Reads the SAME three grant shapes the table gates do. `hasAny` is a list/set method: calling it
    // on a map-shaped grant is not a false result but an evaluation ERROR, which denies the read — so
    // gating on the legacy list alone locked out every grant the access UI writes today (buildGrants
    // returns a map). Split by type exactly like listAllowed above.
    function pageAllowed(doc) {
      let pa = pageAccessMap();
      let t = userData().tables;
      return !(doc in pa)                                   // untagged page -> all registered
        || t == 'all'
        || (t is list && t.hasAny(pa[doc]))                 // grant on any listed table
        || (t is map && t.keys().hasAny(pa[doc]));
    }
    match /_pages__active/{doc} {
      allow read:  if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' || pageAllowed(doc)
      );
      allow write: if request.auth != null && (noUsers() || role() == 'admin' || role() == 'editor');
    }

    // Stored image assets: a view background or an image cell's bytes, kept as a raster data: URI in the
    // DATABASE for deployments with no Storage bucket (Firebase Storage requires the Blaze plan, so on a
    // free project uploadFile's put() fails at runtime). Same trade the _profiles avatar already makes.
    //
    // Read by every registered user: these are decoration, and an asset is displayed wherever the view or
    // row that references it is displayed — the referencing row stays gated by its own rules, which is what
    // actually controls who sees the image in context. Written by admins/editors, like page bodies.
    //
    // The shape is pinned so this can't become a general blob dump: exactly { id, src } (putRow persists
    // the id inside the row, hence both keys), src a string within the cap. The cap must stay in step with
    // supabase-schema.sql's app_valid_shape — rules-parity.test.js compares the two size-cap multisets.
    // 900000 < Firestore's 1048576-byte document limit, leaving room for the rest of the document.
    match /_assets__active/{doc} {
      allow read:  if request.auth != null && isRegistered();
      // create/update (not `write`): a delete carries no request.resource, so a shape test on it would
      // ERROR rather than pass. Split like the _meta block does, so each verb tests only what exists.
      allow create, update: if request.auth != null && (noUsers() || role() == 'admin' || role() == 'editor')
                   && request.resource.data.keys().hasOnly(['id', 'src'])
                   && request.resource.data.src is string
                   && request.resource.data.src.size() <= 900000;
      allow delete: if request.auth != null && (noUsers() || role() == 'admin' || role() == 'editor');
    }

    // Data tables (never _meta or _lists). Read needs table access. Writes split into create/update/delete
    // so OWNER-SCOPED self-service rows work: a registered member may create/edit/delete ONLY their own
    // row (one carrying `owner == their email`), no table-editor grant required — this backs the RSVP /
    // sign-up pattern. Rows without an `owner` field keep the plain per-table editor gate. Admins write all.
    // The data catch-all must NOT also match a system collection, or its permissive owner-create branch
    // (`request.resource.data.owner == myEmail()`) lets ANY registered user mint e.g. an _users doc with
    // role:'admin' — a privilege escalation, since role() reads that doc. Firestore ORs overlapping match
    // blocks, so naming only _meta/_lists here left _users/_profiles/_access_requests reachable through
    // this rule. Exclude the whole underscore namespace (fail-safe: a future system collection is denied
    // here by default and must get its own block — _pages__active has one above).
    function base(coll) { return request.auth != null && isRegistered() && !coll.matches('^_.*'); }
    // Self-service is bounded to tables that DECLARE an owner column -- mirrored to _meta/ownerTables by
    // saveSchema (BackendHelpers.ownerTablesOf). Without this, owner-create was allowed on ANY table, so a
    // registered member could inject owner-stamped junk rows into tables never meant for self-service.
    // Migration: if the doc doesn't exist yet (rules deployed before the schema was re-saved), fall back to
    // permissive so existing sign-up flows don't break -- enforcement activates on the next schema save.
    function selfServiceTable(coll) {
      return !exists(/databases/$(database)/documents/_meta/ownerTables)
        || (coll.split('__')[0] in get(/databases/$(database)/documents/_meta/ownerTables).data.tables);
    }
    // --- Owner-scoped writes, bounded per COLUMN -------------------------------------------------
    // The owner branch below is otherwise all-or-nothing: a member may rewrite every field of their own
    // row, which on a table carrying an approval column means approving themselves. A table may declare
    // `ownerWritable: [cols]`, mirrored by saveSchema to _meta/ownerWritable as
    //   { <table>: { cols: [...], locked: { col: valueItMustHaveAtCreate } } }
    // Absent doc, or a table not listed -> unchanged behaviour (the owner may write the whole row), so
    // this is opt-in and no existing deployment changes shape.
    function ownerBounds(coll) {
      return get(/databases/$(database)/documents/_meta/ownerWritable).data[coll.split('__')[0]];
    }
    function ownerBounded(coll) {
      return exists(/databases/$(database)/documents/_meta/ownerWritable)
        && (coll.split('__')[0] in get(/databases/$(database)/documents/_meta/ownerWritable).data);
    }
    // Fields any owner write may carry regardless: identity and the bookkeeping every write stamps.
    // '_status' is permitted as a KEY here and constrained by VALUE in statusValueOk:
    // the app stamps it on every row it creates, so a table with ownerWritable bounds would otherwise
    // refuse every self-service create. Letting the key through costs nothing -- the owner may only
    // ever send the value the row already has, or 'active' on a new one.
    function ownerSystemCols() { return ['id', 'owner', 'created_at', 'updated_at', 'rosterPublic', '_status']; }
    // CREATE: diffing the incoming row against the `locked` map leaves a gated column OUT of
    // affectedKeys exactly when it already holds its declared default — so "you may not start a row
    // already approved" is one comparison rather than a loop the rules language does not have.
    function ownerCreateOk(coll) {
      return !ownerBounded(coll)
        || (ownerIdentityOk(coll)
            && request.resource.data.diff(ownerBounds(coll).locked).affectedKeys()
                 .hasOnly(ownerBounds(coll).cols.concat(ownerSystemCols())));
    }
    // `ownerWritableWhile: {col: value|[values]}` -> mirrored as whileCol + whileVals. The owner branch
    // reaches a STORED row only while it still holds one of those values: "you may fix your entry until
    // it is approved". An empty whileCol (the default) means no state gate. Read off `resource.data`,
    // never `request.resource.data`, so an owner cannot slip past by sending a compliant state along
    // with their edit.
    // A mirror written BEFORE this feature has no `whileCol` key at all, and reading a missing property
    // is an evaluation ERROR in rules (not undefined) — which denied every owner write on any deployment
    // that had not re-saved its schema. Probe with `in` first: absent = no gate, the pre-feature
    // behaviour. (Caught by dev/test-emulator/firestore-rules.mjs on its first run.)
    function ownerStateOk(coll) {
      return !ownerBounded(coll)
        || !('whileCol' in ownerBounds(coll))
        || ownerBounds(coll).whileCol == ''
        || (resource.data[ownerBounds(coll).whileCol] in ownerBounds(coll).whileVals);
    }
    // An IDENTITY column (`defaultFrom: "@me"`, and owner-writable because otherwise the owner could not
    // create the row at all) may only ever carry the CALLER'S OWN value — without this a member could log
    // the work as somebody else, which the column bounds cannot catch: the column IS one they may write.
    // The caller's value comes from `_users/<email>.identity`, mirrored by setListUser. That doc is
    // admin-write-only, so a member cannot forge it, and userData() has already fetched it — this costs
    // no extra get(). A QUERY (find the link naming me) is what rules cannot do; this is the same
    // denormalize-for-schema-blind-rules trick as rwTables.
    //   Enforced only for a column backed by a LIST. Without one the identity is the profile display
    // name, which the user writes themselves, so there would be nothing to verify against.
    //   No `identity` map on the grant -> migration grace, permissive, exactly like selfServiceTable():
    // it starts binding once an admin re-saves the links.
    function ownerIdentityOk(coll) {
      let b = ownerBounds(coll);
      let u = userData();
      return !ownerBounded(coll)
        || !('identityCol' in b) || b.identityCol == '' || b.identityList == ''
        || !(b.identityCol in request.resource.data)
        || !('identity' in u)
        || request.resource.data[b.identityCol] == u.identity.get(b.identityList, '__no_identity__');
    }
    // UPDATE: the row must still be in an owner-writable state, and only listed columns may change value.
    function ownerUpdateOk(coll) {
      return !ownerBounded(coll)
        || (ownerStateOk(coll) && ownerIdentityOk(coll)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(ownerBounds(coll).cols.concat(ownerSystemCols())));
    }
    // ---- _status: the partition, as data -------------------------------------------------------
    // A row's partition is becoming a FIELD rather than a separate collection. That makes it data, and
    // data on a self-service row is data its owner can write.
    //
    // The gate is a VOCABULARY, not a prohibition. An owner could already file their own row away under
    // the old model -- archiving was a delete from one collection plus a create in the other, and both
    // halves are permitted on a row you own -- so refusing the equivalent field write would REMOVE a
    // capability (withdrawing your own signup) rather than harden anything. What is worth closing is
    // the other door: `_status` may only ever name a partition. A future rule that gates archived rows
    // differently then has a closed set to reason about, instead of whatever string a client sent.
    //
    // WHEN an owner may touch the row at all is already answered elsewhere -- ownerStateOk
    // (`ownerWritableWhile`) governs that, exactly as it governs their delete.
    //
    // .get access, not dot: a rules identifier cannot begin with an underscore, so
    // `request.resource.data._status` is an evaluation ERROR rather than a field read -- which surfaces
    // as PERMISSION_DENIED with no indication why. `.get` folds in the absent case too, and an absent
    // _status IS 'active' everywhere.
    function statusValueOk() {
      return request.resource.data.get('_status', 'active') in ['active', 'archive'];
    }

    match /{collection}/{doc} {
      // Read: owner-stamped rows are private to their owner UNLESS marked rosterPublic (a per-table policy
      // denormalized onto each row) — members self-serve without a table grant and read only their own,
      // while a public roster is readable by all and organizers (table grant) / admins read every row.
      // Non-owner rows keep the plain per-table gate.
      // Written as a FLAT disjunction of field comparisons, not a ternary on `'owner' in resource.data`.
      // Rules are not filters: a collection query is allowed only if the rule is provable from the
      // query's own constraints, and `'owner' in resource.data` is a per-document test no constraint can
      // prove -- so the ternary form denied every list read by a member without a table grant, which is
      // exactly the self-service case ("see the rows I own"). Flat, a client constraining on `owner` or
      // `rosterPublic` proves the matching disjunct. `.get(field, default)` keeps a document that lacks
      // the field from erroring the whole expression, which is what the ternary was guarding against.
      // Note this makes `rosterPublic: true` mean "public row" on its own rather than only on an
      // owner-stamped one; the app stamps the two together (see app-core _createBlankRow).
      allow read: if base(collection) && (
        noUsers() || role() == 'admin' || hasTableAccess(collection) ||
        resource.data.get('owner', '') == myEmail() ||
        resource.data.get('rosterPublic', false) == true
      );
      allow create: if base(collection) && (
        noUsers() || role() == 'admin' ||
        (request.resource.data.owner == myEmail() && selfServiceTable(collection) && ownerCreateOk(collection) && statusValueOk()) || // self-service: my own row, only on an owner-column table, only the fields I may set
        (role() == 'editor' && hasTableWrite(collection))
      );
      allow update: if base(collection) && (
        noUsers() || role() == 'admin' ||
        // edit my own (can't reassign owner) — bounded to owner-column tables like create, so a stray
        // owner-stamped row in a non-self-service table doesn't stay member-editable forever
        (resource.data.owner == myEmail() && request.resource.data.owner == myEmail() && selfServiceTable(collection) && ownerUpdateOk(collection) && statusValueOk()) ||
        (role() == 'editor' && hasTableWrite(collection))
      );
      allow delete: if base(collection) && (
        noUsers() || role() == 'admin' ||
        (resource.data.owner == myEmail() && selfServiceTable(collection) && ownerStateOk(collection)) || // delete my own owned row (self-service tables only, and only while it is still owner-writable)
        (role() == 'editor' && hasTableWrite(collection))
      );
    }
  }
}
