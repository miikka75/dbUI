rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function noUsers() { return !exists(/databases/$(database)/documents/_meta/users); }
    function userData() { return get(/databases/$(database)/documents/_meta/users).data[request.auth.token.email]; }
    function role() { return noUsers() ? 'admin' : (userData() != null ? userData().role : null); } // bootstrap = admin
    function isRegistered() { return noUsers() || userData() != null; }
    function hasTableAccess(collection) {
      let table = collection.split('__')[0];
      return userData().tables == 'all' || table in userData().tables;
    }
    function listAllowed() {
      return userData().tables == 'all' || userData().tables.hasAny(resource.data.tables);
    }

    // Meta: read by registered. Write by admin (or bootstrap). Editors may write the shared lists doc only.
    // The legacy `lists` doc is admin-only read now that per-list `_lists/*` is the source of truth.
    match /_meta/{doc} {
      allow read: if request.auth != null && isRegistered() && (doc != 'lists' || noUsers() || role() == 'admin');
      allow write: if request.auth != null && (
        noUsers() || role() == 'admin' || (doc == 'lists' && role() == 'editor')
      );
    }

    // Per-list storage: each list is its own doc carrying its owning `tables`. Read/write gated on
    // whether the user has access to any owning table (admins/bootstrap unrestricted).
    match /_lists/{listName} {
      allow read: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' || listAllowed()
      );
      allow write: if request.auth != null && isRegistered() && (
        noUsers() || role() == 'admin' || (role() == 'editor' && listAllowed())
      );
    }

    // Data tables (never _meta or _lists). Read needs table access; write additionally requires a writable role (viewers are read-only).
    match /{collection}/{doc} {
      allow read: if request.auth != null && isRegistered() && collection != '_meta' && collection != '_lists' && (
        noUsers() || role() == 'admin' || hasTableAccess(collection)
      );
      allow write: if request.auth != null && isRegistered() && collection != '_meta' && collection != '_lists' && (
        noUsers() || role() == 'admin' || (role() == 'editor' && hasTableAccess(collection))
      );
    }
  }
}
