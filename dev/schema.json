{
  "defaultLanguage": "en",
  "tables": {
    "tasks": {
      "columns": [
        {
          "name": "date",
          "type": "date",
          "syncFrom": "notes"
        },
        {
          "name": "title",
          "type": "text",
          "syncFrom": "notes"
        },
        {
          "name": "status",
          "type": "select",
          "list": "status"
        },
        {
          "name": "assigned_to",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true,
          "sorted": true
        },
        {
          "name": "city",
          "type": "ref",
          "table": "cities",
          "valueCol": "city",
          "filterBy": {
            "state": "state"
          }
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "notes": {
      "columns": [
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "content",
          "type": "text"
        },
        {
          "name": "author",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "cities": {
      "columns": [
        {
          "name": "state",
          "type": "text"
        },
        {
          "name": "city",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "isLookup": true
    }
  },
  "views": [
    {
      "name": "combined",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "columns": [
        "date",
        "title",
        {
          "filter": {
            "status": "open"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "defaultSort": "date",
          "sources": [
            "tasks"
          ]
        },
        {
          "filter": {
            "status": "in_progress"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "layout": "table",
          "hideEmpty": true,
          "sources": [
            "tasks"
          ]
        },
        "status",
        "assigned_to",
        "city",
        "content",
        "author"
      ],
      "defaultSort": "date"
    },
    {
      "name": "attendance",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "assigned_to",
          "author"
        ]
      },
      "collect": "date",
      "columns": [
        "person",
        "latest",
        "previous",
        "3rd"
      ],
      "icon": "mdi-account-group"
    },
    {
      "name": "report_open",
      "icon": "mdi-progress-clock",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "filter": {
        "status": "open"
      },
      "readonly": true,
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to",
        "content",
        "author"
      ]
    },
    {
      "name": "report_in_progress",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "filter": {
        "status": "in_progress"
      },
      "readonly": true,
      "layout": "table",
      "hideEmpty": true,
      "columns": [
        "date",
        "title",
        "assigned_to"
      ]
    },
    {
      "name": "all_items",
      "sources": [
        "tasks",
        "notes"
      ],
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to",
        "city",
        {
          "content": {
            "status": "in_progress"
          }
        },
        "author"
      ],
      "mode": "union",
      "defaultSort": "date",
      "layout": "table"
    },
    {
      "name": "summary_cards",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "layout": "card",
      "collapsed": true,
      "columns": [
        "title",
        "status",
        "assigned_to"
      ]
    },
    {
      "name": "quick_list",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "layout": "list",
      "columns": [
        "title",
        "status"
      ]
    }
  ],
  "nav": {
    "layout": "drawer",
    "items": [
      {
        "page": "combined_page"
      },
      {
        "view": "attendance",
        "icon": "mdi-account-group"
      },
      {
        "page": "progress_report_page",
        "icon": "mdi-progress-clock"
      },
      {
        "view": "all_items",
        "items": [
          {
            "view": "summary_cards"
          },
          {
            "view": "quick_list"
          }
        ]
      },
      {
        "group": "Data",
        "icon": "mdi-database",
        "items": [
          {
            "table": "tasks"
          },
          {
            "table": "notes"
          }
        ]
      }
    ]
  },
  "pages": {
    "combined_page": {
      "markdown": "{{t:view.combined.header}}\n\n{{view:combined}}\n\n## Attendance\n\n{{view:attendance}}\n\n## Archived tasks\n\n{{table:tasks@archive?}}\n\n## Notes\n\n{{table:notes}}\n\n{{t:view.combined.footer}}"
    },
    "progress_report_page": {
      "markdown": "{{t:view.progress_report.header}}\n\n## {{t:embed.open.title}}\n\n{{view:report_open}}\n\n## {{t:embed.ip.title}}\n\n{{view:report_in_progress?}}\n\n{{t:embed.ip.attention}}\n\n{{t:view.progress_report.footer}}"
    }
  }
}
