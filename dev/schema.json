{
  "icon": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='28' font-size='28'>📋</text></svg>",
  "defaultLanguage": "en",
  "tables": {
    "tasks": {
      "columns": [
        {
          "name": "date",
          "type": "date",
          "syncFrom": "notes"
        },
        {
          "name": "title",
          "type": "text",
          "syncFrom": "notes"
        },
        {
          "name": "status",
          "type": "select",
          "list": "status"
        },
        {
          "name": "assigned_to",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true,
          "sorted": true,
          "listSwitch": { "label": "External", "list": "external_workers" }
        },
        {
          "name": "city",
          "type": "ref",
          "table": "cities",
          "valueCol": "city",
          "filterBy": {
            "state": "state"
          }
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "notes": {
      "columns": [
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "content",
          "type": "text"
        },
        {
          "name": "author",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "cities": {
      "columns": [
        {
          "name": "state",
          "type": "text"
        },
        {
          "name": "city",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "isLookup": true
    }
  },
  "views": [
    {
      "name": "combined",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "columns": [
        "date",
        "title",
        {
          "filter": {
            "status": "open"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "defaultSort": "date",
          "sources": [
            "tasks"
          ]
        },
        {
          "filter": {
            "status": "in_progress"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "layout": "table",
          "hideEmpty": true,
          "sources": [
            "tasks"
          ]
        },
        "status",
        "assigned_to",
        "city",
        "content",
        "author"
      ],
      "defaultSort": "date"
    },
    {
      "name": "attendance",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "assigned_to",
          "author"
        ]
      },
      "collect": "date",
      "collectWith": "role",
      "columns": [
        "person",
        "latest",
        "previous",
        "3rd"
      ],
      "icon": "mdi-account-group"
    },
    {
      "name": "report_open",
      "layout": "card",
      "icon": "mdi-progress-clock",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "filter": {
        "status": "open"
      },
      "readonly": true,
      "columns": [
        "date",
        "title",
        "status",
        {
          "view": "in_progress_block",
          "bare": true
        },
        "assigned_to",
        "content",
        "author"
      ]
    },
    {
      "name": "report_in_progress",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "filter": {
        "status": "in_progress"
      },
      "readonly": true,
      "layout": "table",
      "hideEmpty": true,
      "columns": [
        "date",
        "title",
        "assigned_to"
      ]
    },
    {
      "name": "all_items",
      "sources": [
        "tasks",
        "notes"
      ],
      "hideEmpty": true,
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to",
        { "name": "city", "hideEmpty": false },
        {
          "content": {
            "status": "in_progress"
          }
        },
        "author"
      ],
      "mode": "union",
      "defaultSort": "date",
      "layout": "table"
    },
    {
      "name": "open_tasks",
      "sources": ["tasks"],
      "mode": "union",
      "filter": { "status": "open" },
      "readonly": true,
      "columns": ["date", "title"]
    },
    {
      "name": "summary_cards",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "layout": "card",
      "collapsed": true,
      "columns": [
        "title",
        "status",
        "assigned_to",
        { "view": "open_tasks", "filterBy": { "assigned_to": "assigned_to" }, "hideEmpty": true, "bare": true }
      ]
    },
    {
      "name": "quick_list",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "layout": "list",
      "columns": [
        "title",
        "status"
      ]
    },
    {
      "name": "combined_page",
      "markdown": "{{t:view.combined.header}}\n\n{{view:combined}}\n\n## Attendance\n\n{{view:attendance}}\n\n## Archived tasks\n\n{{table:tasks@archive?}}\n\n## Notes\n\n{{table:notes}}\n\n{{t:view.combined.footer}}"
    },
    {
      "name": "progress_report_page",
      "markdown": "{{t:view.progress_report.header}}\n\n## {{t:embed.open.title}}\n\n{{view:report_open}}\n\n## {{t:embed.ip.title}}\n\n{{view:report_in_progress?}}\n\n{{t:embed.ip.attention}}\n\n{{t:view.progress_report.footer}}"
    },
    {
      "name": "in_progress_block",
      "markdown": "**{{t:embed.ip.title}}**\n\n{{view:report_in_progress}}\n\n_{{t:embed.ip.attention}}_"
    },
    {
      "name": "task_doc",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "defaultSort": "date",
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to"
      ],
      "markdown": "## Tasks\n\nProse above the view's **own** editable grid (placed with the self token):\n\n{{self}}\n\n_One view = prose + its own data._"
    },
    {
      "name": "active_work",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "filter": {
        "status": [
          "open",
          "in_progress"
        ]
      },
      "readonly": true,
      "defaultSort": "date",
      "icon": "mdi-clipboard-list-outline",
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to"
      ]
    }
  ],
  "nav": {
    "layout": "drawer",
    "items": [
      {
        "view": "combined_page"
      },
      {
        "view": "attendance",
        "icon": "mdi-account-group"
      },
      {
        "icon": "mdi-progress-clock",
        "view": "progress_report_page"
      },
      {
        "icon": "mdi-text-box",
        "view": "task_doc"
      },
      {
        "icon": "mdi-clipboard-list-outline",
        "view": "active_work"
      },
      {
        "view": "all_items",
        "items": [
          {
            "view": "summary_cards"
          },
          {
            "view": "quick_list"
          }
        ]
      },
      {
        "group": "Data",
        "icon": "mdi-database",
        "items": [
          {
            "table": "tasks"
          },
          {
            "table": "notes"
          }
        ]
      }
    ]
  }
}
