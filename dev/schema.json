{
  "schemaVersion": 3,
  "icon": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='28' font-size='28'>📋</text></svg>",
  "theme": {
    "light": { "primary": "#00695c", "secondary": "#26a69a" },
    "dark": { "primary": "#4db6ac", "secondary": "#26a69a" }
  },
  "defaultLanguage": "en",
  "translatableLists": ["ticket_stages"],
  "listSources": {
    "members": "users"
  },
  "tables": {
    "tasks": {
      "columns": [
        {
          "name": "date",
          "type": "date",
          "syncFrom": "notes"
        },
        {
          "name": "title",
          "type": "text",
          "syncFrom": "notes"
        },
        {
          "name": "status",
          "type": "select",
          "list": "status"
        },
        {
          "name": "assigned_to",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true,
          "sorted": true,
          "listSwitch": {
            "label": "External",
            "list": "external_workers"
          }
        },
        {
          "name": "city",
          "type": "ref",
          "table": "cities",
          "valueCol": "city",
          "filterBy": {
            "state": "state"
          }
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "notes": {
      "columns": [
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "content",
          "type": "text"
        },
        {
          "name": "author",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true
        },
        {
          "name": "photo",
          "type": "image"
        },
        {
          "name": "link",
          "type": "url"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "cities": {
      "columns": [
        {
          "name": "state",
          "type": "text"
        },
        {
          "name": "city",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "isLookup": true
    },
    "crew_rotation": {
      "columns": [
        {
          "name": "position",
          "type": "number",
          "hidden": true
        },
        {
          "name": "people",
          "type": "select",
          "multiple": true,
          "list": "crew",
          "allowNew": true
        }
      ],
      "reorderable": true,
      "defaultSort": "position"
    },
    "chore_log": {
      "archivable": true,
      "defaultSort": "done_on",
      "columns": [
        {
          "name": "chore",
          "type": "ref",
          "table": "chores",
          "valueCol": "chore"
        },
        {
          "name": "person",
          "type": "select",
          "list": "members",
          "allowNew": true
        },
        {
          "name": "done_on",
          "type": "date"
        }
      ]
    },
    "chores": {
      "columns": [
        {
          "name": "chore",
          "type": "text"
        },
        {
          "name": "points",
          "type": "number"
        }
      ]
    },
    "practices": {
      "archivable": true,
      "defaultSort": "date",
      "columns": [
        { "name": "date", "type": "date" },
        { "name": "title", "type": "text" },
        { "name": "opponent", "type": "text" }
      ]
    },
    "rsvps": {
      "columns": [
        { "name": "owner", "type": "owner" },
        { "name": "practice", "type": "ref", "table": "practices", "valueCol": "id" },
        { "name": "response", "type": "select", "list": "rsvp_status" },
        { "name": "note", "type": "text" }
      ]
    },
    "tickets": {
      "archivable": true,
      "columns": [
        { "name": "title", "type": "text" },
        { "name": "status", "type": "select", "list": "ticket_status" },
        { "name": "assignee", "type": "select", "list": "assigned_to", "allowNew": true },
        { "name": "stage", "type": "ref", "table": "ticket_stages", "valueCol": "stage" },
        { "name": "created_at", "type": "text", "hidden": true },
        { "name": "updated_at", "type": "text", "hidden": true }
      ]
    },
    "ticket_stages": {
      "isLookup": true,
      "columns": [
        { "name": "phase", "type": "text" },
        { "name": "stage", "type": "text" },
        { "name": "created_at", "type": "text", "hidden": true },
        { "name": "updated_at", "type": "text", "hidden": true }
      ]
    }
  },
  "views": [
    {
      "name": "combined",
      "kind": "data",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "columns": [
        "date",
        "title",
        {
          "filter": {
            "status": "open"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "defaultSort": "date",
          "sources": [
            "tasks"
          ]
        },
        {
          "filter": {
            "status": "in_progress"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "layout": "table",
          "hideEmpty": true,
          "sources": [
            "tasks"
          ]
        },
        "status",
        "assigned_to",
        "city",
        "content",
        "author"
      ],
      "defaultSort": "date"
    },
    {
      "name": "attendance",
      "kind": "data",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "assigned_to",
          "author"
        ]
      },
      "collect": "date",
      "collectWith": "role",
      "columns": [
        "person",
        "latest",
        "previous",
        "3rd"
      ],
      "icon": "mdi-account-group"
    },
    {
      "name": "report_open",
      "kind": "data",
      "layout": "card",
      "icon": "mdi-progress-clock",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "filter": {
        "status": "open"
      },
      "readonly": true,
      "columns": [
        "date",
        "title",
        "status",
        {
          "view": "in_progress_block",
          "bare": true
        },
        "assigned_to",
        "content",
        "author"
      ]
    },
    {
      "name": "report_in_progress",
      "kind": "data",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "filter": {
        "status": "in_progress"
      },
      "readonly": true,
      "layout": "table",
      "hideEmpty": true,
      "columns": [
        "date",
        "title",
        "assigned_to"
      ]
    },
    {
      "name": "all_items",
      "kind": "data",
      "sources": [
        "tasks",
        "notes"
      ],
      "hideEmpty": true,
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to",
        {
          "name": "city",
          "hideEmpty": false
        },
        {
          "name": "content",
          "when": {
            "status": "in_progress"
          }
        },
        "author"
      ],
      "mode": "union",
      "defaultSort": "date",
      "layout": "table"
    },
    {
      "name": "open_tasks",
      "kind": "data",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "filter": {
        "status": "open"
      },
      "readonly": true,
      "columns": [
        "date",
        "title"
      ]
    },
    {
      "name": "summary_cards",
      "kind": "data",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "layout": "card",
      "collapsed": true,
      "columns": [
        "title",
        "status",
        "assigned_to",
        {
          "view": "open_tasks",
          "filterBy": {
            "assigned_to": "assigned_to"
          },
          "hideEmpty": true,
          "bare": true
        }
      ]
    },
    {
      "name": "quick_list",
      "kind": "data",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "layout": "list",
      "columns": [
        "title",
        "status"
      ]
    },
    {
      "name": "notes_list",
      "kind": "data",
      "sources": [
        "notes"
      ],
      "mode": "union",
      "layout": "list",
      "columns": [
        "title",
        "photo"
      ]
    },
    {
      "name": "combined_page",
      "kind": "page",
      "markdown": "{{t:view.combined.header}}\n\n{{view:combined}}\n\n## Attendance\n\n{{view:attendance}}\n\n## Archived tasks\n\n{{table:tasks@archive?}}\n\n## Notes\n\n{{table:notes}}\n\n{{t:view.combined.footer}}"
    },
    {
      "name": "progress_report_page",
      "kind": "page",
      "markdown": "{{t:view.progress_report.header}}\n\n## {{t:embed.open.title}}\n\n{{view:report_open}}\n\n## {{t:embed.ip.title}}\n\n{{view:report_in_progress?}}\n\n{{t:embed.ip.attention}}\n\n{{t:view.progress_report.footer}}"
    },
    {
      "name": "showcase",
      "kind": "page",
      "markdown": "# Showcase\n\nA single markdown page-view that embeds **every** kind of element — data view, table, calendar, rotation, pivot, RSVP, aggregate, a nested doc-view, and an archive partition — to demonstrate that any view can be composed into one.\n\n## Data view (union + inline embeds)\n\n{{view:combined}}\n\n## Table\n\n{{table:notes}}\n\n## Calendar\n\n{{view:chore_calendar}}\n\n## Rotation\n\n{{view:crewrota}}\n\n## Pivot (chore heatmap)\n\n{{view:chore_heatmap}}\n\n## RSVP (self-service sign-up)\n\n{{view:my_rsvp}}\n\n## Aggregate (leaderboard)\n\n{{view:leaderboard}}\n\n## Nested doc-view\n\n{{view:task_doc}}\n\n## Archived tasks (hidden when empty)\n\n{{table:tasks@archive?}}"
    },
    {
      "name": "in_progress_block",
      "kind": "page",
      "markdown": "**{{t:embed.ip.title}}**\n\n{{view:report_in_progress}}\n\n_{{t:embed.ip.attention}}_"
    },
    {
      "name": "task_doc",
      "kind": "page",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "defaultSort": "date",
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to"
      ],
      "markdown": "## Tasks\n\nProse above the view's **own** editable grid (placed with the self token):\n\n{{self}}\n\n_One view = prose + its own data._"
    },
    {
      "name": "active_work",
      "kind": "data",
      "sources": [
        "tasks"
      ],
      "mode": "union",
      "filter": {
        "status": [
          "open",
          "in_progress"
        ]
      },
      "readonly": true,
      "defaultSort": "date",
      "icon": "mdi-clipboard-list-outline",
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to"
      ]
    },
    {
      "name": "tickets_board",
      "kind": "board",
      "sources": [
        "tickets"
      ],
      "mode": "join",
      "defaultSort": "title",
      "icon": "mdi-view-column-outline",
      "board": {
        "lane": "status",
        "lanes": [
          "open",
          "in_progress",
          "done"
        ],
        "color": "assignee",
        "addInLane": true
      },
      "columns": [
        "title",
        "assignee"
      ]
    },
    {
      "name": "ticket_pipeline",
      "kind": "board",
      "sources": [
        "tickets"
      ],
      "mode": "join",
      "defaultSort": "title",
      "icon": "mdi-source-branch",
      "board": {
        "lane": "stage",
        "color": "assignee",
        "addInLane": true
      },
      "columns": [
        "title",
        "assignee"
      ]
    },
    {
      "name": "crewrota",
      "kind": "rotation",
      "rotation": {
        "columns": [
          {
            "name": "crew",
            "rotationTable": "crew_rotation",
            "advanceBy": "calendar",
            "interval": "weekly"
          }
        ],
        "range": {
          "from": "today",
          "periods": 12
        }
      },
      "layout": "table"
    },
    {
      "name": "chore_calendar",
      "kind": "calendar",
      "calendar": {
        "source": "chore_log",
        "dateColumn": "done_on",
        "titleColumns": [
          "chore",
          "person"
        ],
        "defaultView": "month"
      }
    },
    {
      "name": "chore_heatmap",
      "kind": "pivot",
      "pivot": {
        "source": "chore_log",
        "row": "person",
        "column": "chore",
        "aggregate": "count",
        "totals": "count"
      }
    },
    {
      "name": "my_rsvp",
      "kind": "rsvp",
      "rsvp": {
        "events": "practices",
        "dateColumn": "date",
        "titleColumns": ["title", "opponent"],
        "responses": "rsvps",
        "statusColumn": "response",
        "picker": "toggle",
        "showCounts": true,
        "rosterVisibility": "all"
      }
    },
    {
      "name": "leaderboard",
      "kind": "data",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "person"
        ]
      },
      "compute": [
        {
          "name": "points",
          "computed": {
            "lookup": {
              "table": "chores",
              "match": "chore",
              "on": "chore",
              "field": "points"
            }
          }
        }
      ],
      "aggregate": {
        "sum": "points",
        "into": "total"
      },
      "columns": [
        "person",
        "total"
      ],
      "period": "month",
      "filter": {
        "done_on": {
          "within": "@month"
        }
      }
    },
    {
      "name": "leaderboard_week",
      "kind": "data",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "person"
        ]
      },
      "compute": [
        {
          "name": "points",
          "computed": {
            "lookup": {
              "table": "chores",
              "match": "chore",
              "on": "chore",
              "field": "points"
            }
          }
        }
      ],
      "aggregate": {
        "sum": "points",
        "into": "total"
      },
      "columns": [
        "person",
        "total"
      ],
      "period": "week",
      "filter": {
        "done_on": {
          "within": "@week"
        }
      },
      "icon": "mdi-trophy-variant"
    },
    {
      "name": "chores_last_month",
      "kind": "data",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "person"
        ]
      },
      "aggregate": {
        "count": true,
        "into": "total"
      },
      "columns": [
        "person",
        "total"
      ],
      "filter": {
        "done_on": {
          "within": "@month-1"
        }
      },
      "readonly": true,
      "icon": "mdi-history"
    },
    {
      "name": "my_chores",
      "kind": "data",
      "sources": [
        "chore_log"
      ],
      "mode": "union",
      "defaultSort": "done_on",
      "columns": [
        "done_on",
        "chore"
      ],
      "filter": {
        "person": "@me"
      },
      "readonly": true,
      "icon": "mdi-account-check"
    }
  ],
  "nav": {
    "layout": "drawer",
    "items": [
      {
        "view": "combined_page"
      },
      {
        "view": "attendance",
        "icon": "mdi-account-group"
      },
      {
        "icon": "mdi-progress-clock",
        "view": "progress_report_page"
      },
      {
        "icon": "mdi-view-dashboard-variant",
        "view": "showcase"
      },
      {
        "icon": "mdi-text-box",
        "view": "task_doc"
      },
      {
        "icon": "mdi-clipboard-list-outline",
        "view": "active_work"
      },
      {
        "icon": "mdi-view-column-outline",
        "view": "tickets_board"
      },
      {
        "icon": "mdi-source-branch",
        "view": "ticket_pipeline"
      },
      {
        "view": "all_items",
        "items": [
          {
            "view": "summary_cards"
          },
          {
            "view": "quick_list"
          },
          {
            "view": "notes_list"
          }
        ]
      },
      {
        "group": "Data",
        "icon": "mdi-database",
        "items": [
          {
            "table": "tasks"
          },
          {
            "table": "notes"
          }
        ]
      },
      {
        "view": "crewrota"
      },
      {
        "table": "crew_rotation"
      },
      {
        "view": "chore_calendar",
        "icon": "mdi-calendar-check"
      },
      {
        "view": "chore_heatmap",
        "icon": "mdi-grid"
      },
      {
        "view": "my_rsvp",
        "icon": "mdi-account-check"
      },
      {
        "table": "practices",
        "icon": "mdi-whistle"
      },
      {
        "table": "chore_log"
      },
      {
        "view": "leaderboard",
        "icon": "mdi-trophy"
      },
      {
        "view": "leaderboard_week",
        "icon": "mdi-trophy-variant"
      },
      {
        "view": "chores_last_month",
        "icon": "mdi-history"
      },
      {
        "view": "my_chores",
        "icon": "mdi-account-check"
      },
      {
        "table": "chores",
        "icon": "mdi-format-list-checks"
      }
    ]
  }
}
