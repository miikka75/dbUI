{
  "$schema": "../../schema.schema.json",
  "defaultLanguage": "en",
  "tables": {
    "tasks": {
      "columns": [
        {
          "name": "date",
          "type": "date",
          "syncFrom": "notes"
        },
        {
          "name": "title",
          "type": "text",
          "syncFrom": "notes"
        },
        {
          "name": "status",
          "type": "select",
          "list": "status"
        },
        {
          "name": "assigned_to",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true
        },
        {
          "name": "city",
          "type": "ref",
          "table": "cities",
          "valueCol": "city",
          "filterBy": {
            "state": "state"
          }
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "notes": {
      "printable": [
        "view",
        "cards"
      ],
      "columns": [
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "content",
          "type": "text"
        },
        {
          "name": "author",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "archivable": true
    },
    "cities": {
      "columns": [
        {
          "name": "state",
          "type": "text"
        },
        {
          "name": "city",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "text",
          "hidden": true
        },
        {
          "name": "updated_at",
          "type": "text",
          "hidden": true
        }
      ],
      "isLookup": true
    },
    "crew_rotation": {
      "columns": [
        {
          "name": "position",
          "type": "number",
          "hidden": true
        },
        {
          "name": "people",
          "type": "multiselect",
          "list": "crew",
          "allowNew": true
        }
      ],
      "reorderable": true,
      "defaultSort": "position"
    },
    "signups": {
      "columns": [
        {
          "name": "owner",
          "type": "owner"
        },
        {
          "name": "dish",
          "type": "text"
        }
      ]
    },
    "tickets": {
      "archivable": true,
      "columns": [
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "status",
          "type": "select",
          "list": "status"
        },
        {
          "name": "assignee",
          "type": "select",
          "list": "assigned_to",
          "allowNew": true
        }
      ]
    }
  },
  "views": [
    {
      "name": "combined",
      "printable": [
        "view",
        "cards"
      ],
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "join",
      "columns": [
        "date",
        "title",
        {
          "filter": {
            "status": "open"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "defaultSort": "date",
          "sources": [
            "tasks"
          ]
        },
        {
          "filter": {
            "status": "in_progress"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "layout": "table",
          "hideEmpty": true,
          "sources": [
            "tasks"
          ]
        },
        "status",
        "assigned_to",
        "city",
        "content",
        "author"
      ],
      "defaultSort": "date"
    },
    {
      "name": "attendance",
      "sources": [
        "tasks",
        "notes"
      ],
      "mode": "union",
      "groupBy": {
        "column": "person",
        "from": [
          "assigned_to",
          "author"
        ]
      },
      "collect": "date",
      "columns": [
        "person",
        "latest",
        "previous",
        "3rd"
      ],
      "icon": "mdi-account-group"
    },
    {
      "name": "progress_report",
      "icon": "mdi-progress-clock",
      "columns": [
        {
          "filter": {
            "status": "open"
          },
          "columns": [
            "date",
            "title",
            "status",
            "assigned_to",
            "content",
            "author"
          ],
          "sources": [
            "tasks",
            "notes"
          ],
          "mode": "join"
        },
        {
          "filter": {
            "status": "in_progress"
          },
          "columns": [
            "date",
            "title",
            "assigned_to"
          ],
          "sources": [
            "tasks"
          ]
        }
      ],
      "readonly": true,
      "sources": [
        "tasks"
      ],
      "mode": "union"
    },
    {
      "name": "all_items",
      "sources": [
        "tasks",
        "notes"
      ],
      "columns": [
        "date",
        "title",
        "status",
        "assigned_to",
        "city",
        "content",
        "author"
      ],
      "mode": "union",
      "defaultSort": "date",
      "layout": "table"
    },
    {
      "name": "crewrota",
      "rotation": {
        "columns": [
          {
            "name": "crew",
            "rotationTable": "crew_rotation",
            "advanceBy": "calendar",
            "interval": "weekly"
          }
        ],
        "range": {
          "from": "2026-01-01",
          "periods": 3
        }
      },
      "layout": "table"
    },
    {
      "name": "cal_fx",
      "calendar": {
        "source": "tasks",
        "dateColumn": "date",
        "titleColumns": [
          "title"
        ],
        "defaultView": "month"
      }
    },
    {
      "name": "tickets_board",
      "sources": [
        "tickets"
      ],
      "mode": "join",
      "defaultSort": "title",
      "board": {
        "lane": "status",
        "lanes": [
          "open",
          "in_progress",
          "done"
        ],
        "color": "assignee"
      },
      "columns": [
        "title",
        "assignee"
      ]
    }
  ],
  "nav": {
    "layout": "drawer",
    "items": [
      {
        "view": "combined",
        "items": [
          {
            "view": "attendance",
            "icon": "mdi-account-group"
          },
          {
            "view": "progress_report",
            "icon": "mdi-progress-clock"
          }
        ]
      },
      {
        "view": "all_items"
      },
      {
        "table": "tasks"
      },
      {
        "table": "notes"
      },
      {
        "view": "crewrota"
      },
      {
        "table": "crew_rotation"
      },
      {
        "table": "signups"
      },
      {
        "view": "tickets_board",
        "icon": "mdi-view-column-outline"
      }
    ]
  },
  "lists": {
    "status": [
      "open",
      "in_progress",
      "done"
    ]
  }
}
